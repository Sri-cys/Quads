{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.quads.supplychain",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://shipping-status",
      "favIcon": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "com.quads.supplychain.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.tnt": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": false
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.quads.supplychain.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.quads.supplychain.view",
        "controlId": "pageContainer",
        "controlAggregation": "pages",
        "bypassed": {
          "target": "dashboard"
        },
        "async": true
      },
      "routes": [
        {
          "name": "dashboard",
          "pattern": "",
          "target": "dashboard"
        },
        {
          "name": "dashboardAlias",
          "pattern": "dashboard",
          "target": "dashboard"
        },
        {
          "name": "cases",
          "pattern": "cases:?query:",
          "target": "cases"
        },
        {
          "name": "newDisruption",
          "pattern": "new-disruption",
          "target": "newDisruption"
        },
        {
          "name": "caseOverview",
          "pattern": "case/:caseId:",
          "target": "caseOverview"
        },
        {
          "name": "caseOverviewAlias",
          "pattern": "cases/:caseId:",
          "target": "caseOverview"
        },
        {
          "name": "caseOverviewKebab",
          "pattern": "case-overview/:caseId:",
          "target": "caseOverview"
        },
        {
          "name": "impactAnalysis",
          "pattern": "impact/:caseId:",
          "target": "impactAnalysis"
        },
        {
          "name": "impactAnalysisKebab",
          "pattern": "impact-analysis/:caseId:",
          "target": "impactAnalysis"
        },
        {
          "name": "impactAnalysisAlt",
          "pattern": "cases/:caseId:/impact",
          "target": "impactAnalysis"
        },
        {
          "name": "checkpoint1",
          "pattern": "checkpoint1/:caseId:",
          "target": "checkpoint1"
        },
        {
          "name": "checkpoint1Kebab",
          "pattern": "checkpoint-1/:caseId:",
          "target": "checkpoint1"
        },
        {
          "name": "checkpoint1Alt",
          "pattern": "cases/:caseId:/checkpoint1",
          "target": "checkpoint1"
        },
        {
          "name": "constraints",
          "pattern": "constraints/:caseId:",
          "target": "constraints"
        },
        {
          "name": "constraintsAlt",
          "pattern": "cases/:caseId:/constraints",
          "target": "constraints"
        },
        {
          "name": "recoveryPlanning",
          "pattern": "recovery/:caseId:",
          "target": "recoveryPlanning"
        },
        {
          "name": "recoveryPlanningKebab",
          "pattern": "recovery-planning/:caseId:",
          "target": "recoveryPlanning"
        },
        {
          "name": "recoveryPlanningAlt",
          "pattern": "cases/:caseId:/recovery",
          "target": "recoveryPlanning"
        },
        {
          "name": "recoveryPlans",
          "pattern": "plans/:caseId:",
          "target": "recoveryPlanning"
        },
        {
          "name": "recoveryPlansAlt",
          "pattern": "cases/:caseId:/plans",
          "target": "recoveryPlanning"
        },
        {
          "name": "decision",
          "pattern": "decision/:caseId:",
          "target": "decision"
        },
        {
          "name": "decisionAlt",
          "pattern": "cases/:caseId:/decision",
          "target": "decision"
        },
        {
          "name": "checkpoint2",
          "pattern": "checkpoint2/:caseId:",
          "target": "decision"
        },
        {
          "name": "checkpoint2Kebab",
          "pattern": "checkpoint-2/:caseId:",
          "target": "decision"
        },
        {
          "name": "checkpoint2Alt",
          "pattern": "cases/:caseId:/checkpoint2",
          "target": "decision"
        },
        {
          "name": "executionMonitoring",
          "pattern": "execution/:caseId:",
          "target": "executionMonitoring"
        },
        {
          "name": "executionMonitoringKebab",
          "pattern": "execution-monitoring/:caseId:",
          "target": "executionMonitoring"
        },
        {
          "name": "executionMonitoringAlt",
          "pattern": "cases/:caseId:/execution",
          "target": "executionMonitoring"
        },
        {
          "name": "monitoring",
          "pattern": "monitoring/:caseId:",
          "target": "executionMonitoring"
        },
        {
          "name": "monitoringAlt",
          "pattern": "cases/:caseId:/monitoring",
          "target": "executionMonitoring"
        },
        {
          "name": "outcome",
          "pattern": "outcome/:caseId:",
          "target": "outcome"
        },
        {
          "name": "outcomeAlt",
          "pattern": "cases/:caseId:/outcome",
          "target": "outcome"
        }
      ],
      "targets": {
        "dashboard": {
          "viewType": "XML",
          "viewName": "Dashboard",
          "viewLevel": 1
        },
        "cases": {
          "viewType": "XML",
          "viewName": "Cases",
          "viewLevel": 2
        },
        "caseOverview": {
          "viewType": "XML",
          "viewName": "CaseOverview",
          "viewLevel": 2
        },
        "newDisruption": {
          "viewType": "XML",
          "viewName": "NewDisruption",
          "viewLevel": 2
        },
        "impactAnalysis": {
          "viewType": "XML",
          "viewName": "ImpactAnalysis",
          "viewLevel": 3
        },
        "checkpoint1": {
          "viewType": "XML",
          "viewName": "Checkpoint1",
          "viewLevel": 4
        },
        "constraints": {
          "viewType": "XML",
          "viewName": "Constraints",
          "viewLevel": 5
        },
        "recoveryPlanning": {
          "viewType": "XML",
          "viewName": "RecoveryPlanning",
          "viewLevel": 6
        },
        "decision": {
          "viewType": "XML",
          "viewName": "Decision",
          "viewLevel": 7
        },
        "executionMonitoring": {
          "viewType": "XML",
          "viewName": "ExecutionMonitoring",
          "viewLevel": 8
        },
        "monitoring": {
          "viewType": "XML",
          "viewName": "Monitoring",
          "viewLevel": 8
        },
        "outcome": {
          "viewType": "XML",
          "viewName": "Outcome",
          "viewLevel": 9
        }
      }
    }
  }
}
