<mvc:View
    controllerName="com.quads.supplychain.controller.Decision"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="decisionPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">

                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Context Subtitle + Back Link -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="FINAL HUMAN DECISION" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Human governance authorization. AI agents generate and evaluate; human supply chain manager decides." class="sapCorporatePageSubtitle bold" />
                    </VBox>
                    <Link
                        text="&#x2190; Back to Recovery Planning"
                        press=".onBackToRecoveryPlanning"
                        class="sapBackLink" />
                </HBox>

                <!-- Zero Feasible Plans Warning (Section 24) -->
                <VBox
                    visible="{= ${dec>/feasible_plans}.length === 0 &amp;&amp; ${dec>/decisionState} === 'PENDING' }"
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #BB0000; background: #FFF5F5; padding: 24px;">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://error" color="#BB0000" size="24px" class="sapUiSmallMarginEnd" />
                        <VBox>
                            <Title text="NO FEASIBLE RECOVERY PLAN" level="H2" class="bold textCritical" />
                            <Text text="All generated recovery plans breached hard enterprise operating constraints. Approval is blocked." class="textDark bold" />
                        </VBox>
                    </HBox>

                    <Table items="{dec>/infeasible_plans}" class="sapUiSmallMarginBottom">
                        <columns>
                            <Column width="120px"><Text text="Plan ID" class="bold" /></Column>
                            <Column><Text text="Strategy" class="bold" /></Column>
                            <Column><Text text="Breach Reason" class="bold textCritical" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{dec>plan_id} ({dec>version})" class="bold" />
                                    <Text text="{dec>strategy}" />
                                    <Text text="{dec>infeasibility_reason}" class="bold textCritical" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <HBox justifyContent="End">
                        <Button
                            text="REJECT &amp; REPLAN"
                            type="Reject"
                            icon="sap-icon://refresh"
                            press=".onOpenRejectDialog"
                            class="sapUiSmallMarginEnd" />
                        <Button
                            text="MODIFY CONSTRAINTS / PLAN"
                            type="Default"
                            icon="sap-icon://edit"
                            press=".onOpenModifyDialog" />
                    </HBox>
                </VBox>

                <!-- 1. Decision Governance Card -->
                <VBox class="sapDecisionCard sapUiSmallMarginBottom">
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapDecisionHeader">
                        <VBox>
                            <Title text="Governance Authorization Checkpoint" level="H2" class="sapSectionTitle" />
                            <Text text="Review evaluated recovery candidates. Only FEASIBLE plans are eligible for human authorization." class="sapSectionSub" />
                        </VBox>
                        <HBox alignItems="Center">
                            <ObjectStatus
                                text="{= ${dec>/decisionState} === 'APPROVED' ? 'Approved (Locked)' : (${dec>/decisionState} === 'REJECTED' ? 'Rejected' : 'Decision Pending') }"
                                state="{= ${dec>/decisionState} === 'APPROVED' ? 'Success' : (${dec>/decisionState} === 'REJECTED' ? 'Error' : 'Warning') }"
                                inverted="true"
                                class="bold" />
                        </HBox>
                    </HBox>

                    <!-- Approved Success Banner -->
                    <VBox
                        visible="{= ${dec>/decisionState} === 'APPROVED' }"
                        class="sapPhase1Banner sapUiSmallMarginTop sapUiSmallMarginBottom">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://sys-enter-2" class="sapBannerIcon success" />
                            <VBox class="sapUiSmallMarginBegin" width="100%">
                                <Title text="Plan {dec>/selectedPlan/plan_id} ({dec>/selectedPlan/version}) Approved" level="H3" class="sapBannerTitle" />
                                <Text text="Plan baseline locked at {dec>/approvalTimestamp} by {dec>/approvalActor}. Immutable execution snapshot created. Ready for Execution &amp; Monitoring." class="sapBannerText bold" />
                                <HBox class="sapUiSmallMarginTop">
                                    <Button
                                        text="PROCEED TO EXECUTION &amp; MONITORING &#x2192;"
                                        type="Emphasized"
                                        icon="sap-icon://shipping-status"
                                        press=".onProceedToExecution"
                                        class="sapBtnPrimary" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Rejected Warning Banner -->
                    <VBox
                        visible="{= ${dec>/decisionState} === 'REJECTED' }"
                        class="sapPhase1Banner sapUiSmallMarginTop sapUiSmallMarginBottom"
                        style="border-left: 4px solid #BB0000; background: #FFF5F5;">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://decline" class="sapBannerIcon" color="#BB0000" />
                            <VBox class="sapUiSmallMarginBegin" width="100%">
                                <Title text="Recovery Plan Rejected" level="H3" class="sapBannerTitle textCritical" />
                                <Text text="Rejection reason: '{dec>/rejectionReason}'. Recorded in governance audit trail. Planning cycle incremented." class="sapBannerText bold" />
                                <HBox class="sapUiSmallMarginTop">
                                    <Button
                                        text="Return to Recovery Planning"
                                        type="Default"
                                        icon="sap-icon://refresh"
                                        press=".onBackToRecoveryPlanning" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Feasible Plan Selection Cards (Nothing preselected) -->
                    <VBox visible="{= ${dec>/feasible_plans}.length > 0 &amp;&amp; ${dec>/decisionState} === 'PENDING' }" class="sapUiSmallMarginTop">
                        <Title text="Select a Feasible Plan to Review &amp; Authorize" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                        <Text text="Only validated, feasible options are selectable. Nothing is preselected." class="textMuted textSmall sapUiSmallMarginBottom" />

                        <VBox
                            items="{dec>/feasible_plans}"
                            renderType="Bare"
                            class="quadsPlanGrid sapUiSmallMarginBottom">

                            <VBox class="{= ${dec>plan_id} === ${dec>/selectedPlan/plan_id} ? 'sapChoiceCard quadsPlanCard sapChoiceSelected' : 'sapChoiceCard quadsPlanCard' }">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsCardHeaderRow">
                                    <Text text="{= ${dec>version} ? ${dec>plan_id} + ' (' + ${dec>version} + ')' : ${dec>plan_id} }" class="quadsPlanId bold" />
                                    <ObjectStatus text="{dec>score} pts" state="Success" class="bold" />
                                </HBox>

                                <Title text="{dec>strategy}" level="H3" class="quadsCardStrategy bold textDark" />
                                <Text text="Source: {dec>source_name}" visible="{= !!${dec>source_name} }" class="quadsCardRoute textSmall textMuted" />

                                <HBox class="quadsCardMetaGrid sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <VBox class="quadsMetaCol">
                                        <VBox class="quadsMetaItem">
                                            <Text text="TOTAL COST" class="quadsMetaLabel" />
                                            <Text text="{= ${dec>total_cost} ? '$' + ${dec>total_cost}.toLocaleString() : '' }" class="quadsMetaValue bold" />
                                        </VBox>
                                    </VBox>
                                    <VBox class="quadsMetaCol">
                                        <VBox class="quadsMetaItem">
                                            <Text text="LEAD TIME" class="quadsMetaLabel" />
                                            <Text text="{dec>recovery_days} Days" class="quadsMetaValue bold textPrimary" />
                                        </VBox>
                                    </VBox>
                                </HBox>

                                <VBox class="quadsMetaItem sapUiTinyMarginBottom">
                                    <Text text="CUSTOMER IMPACT" class="quadsMetaLabel" />
                                    <Text text="{dec>expected_customer_impact}" class="quadsMetaValue" />
                                </VBox>

                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginTop" style="border-top: 1px solid #E5E5E5; padding-top: 12px;">
                                    <ObjectStatus text="{= ${dec>risk_score} ? ${dec>operational_risk} + ' RISK (' + ${dec>risk_score} + ')' : ${dec>operational_risk} + ' RISK' }" state="{= ${dec>operational_risk} === 'LOW' ? 'Success' : 'Warning' }" class="bold textSmall" />
                                    <Button
                                        text="{= ${dec>plan_id} === ${dec>/selectedPlan/plan_id} ? 'Selected' : 'Select Plan' }"
                                        type="{= ${dec>plan_id} === ${dec>/selectedPlan/plan_id} ? 'Emphasized' : 'Default' }"
                                        icon="{= ${dec>plan_id} === ${dec>/selectedPlan/plan_id} ? 'sap-icon://accept' : 'sap-icon://cursor-arrow' }"
                                        press=".onSelectFeasiblePlan"
                                        class="quadsSelectPlanBtn"
                                        style="min-height: 36px; min-width: 140px;" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Selected Plan Review Block (Visible once a plan is chosen) -->
                    <VBox visible="{= !!${dec>/selectedPlan/plan_id} }" class="sapUiSmallMarginTop">
                        <Title text="Reviewing Selected Plan: {dec>/selectedPlan/plan_id} ({dec>/selectedPlan/version})" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                        
                        <layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiTinyMarginTop sapUiSmallMarginBottom">
                            <VBox class="sapMetricBox">
                                <Text text="Plan Identifier &amp; Version" class="sapContextItemLabel" />
                                <Text text="{= ${dec>/selectedPlan/version} ? ${dec>/selectedPlan/plan_id} + ' (' + ${dec>/selectedPlan/version} + ')' : ${dec>/selectedPlan/plan_id} }" class="bold textLarge textPrimary" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Recovery Strategy" class="sapContextItemLabel" />
                                <Text text="{dec>/selectedPlan/strategy}" class="bold textLarge textDark" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Fulfillment Quantity" class="sapContextItemLabel" />
                                <Text text="{dec>/selectedPlan/recovered_quantity} Units" class="bold textLarge textDark" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Total Recovery Cost" class="sapContextItemLabel" />
                                <Text text="{= ${dec>/selectedPlan/total_cost} ? '$' + ${dec>/selectedPlan/total_cost}.toLocaleString() : '' }" class="bold textLarge textDark" />
                            </VBox>
                        </layout:Grid>

                        <layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiTinyMarginBottom">
                            <VBox class="sapMetricBox">
                                <Text text="Recovery Lead Time" class="sapContextItemLabel" />
                                <Text text="{dec>/selectedPlan/recovery_days} Days" class="bold textMedium textDark" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Source Partner" class="sapContextItemLabel" />
                                <Text text="{= ${dec>/selectedPlan/source_location} ? ${dec>/selectedPlan/source_name} + ' (' + ${dec>/selectedPlan/source_location} + ')' : ${dec>/selectedPlan/source_name} }" class="bold textMedium textDark" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Transport Carrier" class="sapContextItemLabel" />
                                <Text text="{dec>/selectedPlan/transport_name}" class="bold textMedium textDark" />
                            </VBox>
                            <VBox class="sapMetricBox">
                                <Text text="Feasibility Status" class="sapContextItemLabel" />
                                <ObjectStatus text="&#x2713; FEASIBLE &amp; VALIDATED" state="Success" class="bold textMedium" />
                            </VBox>
                        </layout:Grid>

                        <!-- Decision Rationale Input (Enabled when PENDING) -->
                        <VBox visible="{= ${dec>/decisionState} === 'PENDING' }" class="sapUiSmallMarginTop">
                            <Label text="Manager Authorization Mandatory Comment / Operational Rationale" class="bold textSmall" required="true" />
                            <TextArea
                                id="taDecisionRationale"
                                value="{dec>/plannerRationale}"
                                rows="2"
                                width="100%"
                                placeholder="Enter mandatory operational rationale (e.g. Approved by Supply Chain Lead after verifying supplier capacity and logistics transit timeline)..."
                                class="sapUiSmallMarginBottom" />

                            <!-- 3 Explicit Governance Decision Buttons: NO option preselected -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapDecisionActionsRow sapUiSmallMarginTop">
                                <Button
                                    text="Back to Recovery Planning"
                                    type="Transparent"
                                    icon="sap-icon://nav-back"
                                    press=".onBackToRecoveryPlanning"
                                    class="sapBtnSecondary" />

                                <HBox alignItems="Center">
                                    <Button
                                        id="btnRejectPlan"
                                        text="REJECT"
                                        type="Reject"
                                        icon="sap-icon://decline"
                                        press=".onOpenRejectDialog"
                                        class="sapUiSmallMarginEnd" />
                                    <Button
                                        id="btnModifyPlan"
                                        text="MODIFY"
                                        type="Default"
                                        icon="sap-icon://edit"
                                        press=".onOpenModifyDialog"
                                        class="sapUiSmallMarginEnd" />
                                    <Button
                                        id="btnApprovePlan"
                                        text="APPROVE"
                                        type="Emphasized"
                                        icon="sap-icon://accept"
                                        press=".onApprovePlan"
                                        class="sapBtnPrimary" />
                                </HBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Collapsed Infeasible Plans Section -->
                    <Panel
                        expandable="true"
                        expanded="false"
                        headerText="Infeasible Plans · {= ${dec>/infeasible_plans} ? ${dec>/infeasible_plans}.length : 0 } option{= ${dec>/infeasible_plans} &amp;&amp; ${dec>/infeasible_plans}.length === 1 ? '' : 's' } filtered out"
                        class="sapUiSmallMarginTop sapContextCard">

                        <Table items="{dec>/infeasible_plans}" noDataText="No infeasible options.">
                            <columns>
                                <Column width="130px"><Text text="Plan ID" class="bold" /></Column>
                                <Column width="220px"><Text text="Recovery Strategy" class="bold" /></Column>
                                <Column width="200px"><Text text="Source" class="bold" /></Column>
                                <Column><Text text="Reason for Infeasibility" class="bold textCritical" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{dec>plan_id} ({dec>version})" class="bold" />
                                        <Text text="{dec>strategy}" />
                                        <Text text="{dec>source_name}" />
                                        <Text text="{dec>infeasibility_reason}" class="textCritical textSmall" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
