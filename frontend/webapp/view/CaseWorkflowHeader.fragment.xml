<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">
    <VBox>
        <!-- Top Row: Case ID · Title | Meta info right -->
        <VBox class="sapCaseWorkflowHeaderContainer sapUiSmallMarginBottom">
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCaseHeaderTopRow">
            <HBox alignItems="Center">
                <Text text="{app>/selectedCaseId}" class="sapCaseHeaderId" />
                <Text text="·" class="sapCaseHeaderDot" />
                <Title text="{app>/caseTitle}" level="H3" class="sapCaseHeaderTitle" />
            </HBox>
            <HBox alignItems="Center" class="sapCaseHeaderMetaGroup">
                <Text text="Severity:" class="sapCaseMetaLabel sapUiTinyMarginEnd" />
                <ObjectStatus
                    text="{app>/caseSeverity}"
                    state="{= ${app>/caseSeverity} === 'CRITICAL' ? 'Error' : (${app>/caseSeverity} === 'HIGH' ? 'Warning' : 'Success') }"
                    class="sapUiSmallMarginEnd" />
                <Text text="Status:" class="sapCaseMetaLabel sapUiTinyMarginEnd" />
                <ObjectStatus
                    text="{app>/caseStatusText}"
                    state="Information"
                    class="sapUiSmallMarginEnd" />
                <Text text="{app>/lastUpdated}" class="textMuted textSmall" />
            </HBox>
        </HBox>
        </VBox>

        <!-- Workflow Stepper Card -->
        <VBox class="quadsStepperCard sapUiSmallMarginBottom">
            <HBox alignItems="Center" class="quadsStepperRow">

                <!-- 1. CASE -->
                <Button
                    text="Case"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 1 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 1 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="1" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 1 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 2. IMPACT ANALYSIS -->
                <Button
                    text="Impact Analysis"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 2 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 2 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="2" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 2 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 3. PRIORITY -->
                <Button
                    text="Priority"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 3 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 3 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="3" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 3 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 4. CONSTRAINTS -->
                <Button
                    text="Constraints"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 4 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 4 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="4" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 4 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 5. RECOVERY PLANNING -->
                <Button
                    text="Recovery Planning"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 5 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 5 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="5" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 5 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 6. DECISION -->
                <Button
                    text="Decision"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 6 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 6 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="6" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} > 6 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 7. EXECUTION & MONITORING -->
                <Button
                    text="Exec &amp; Monitoring"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 7 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 7 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="7" />
                    </customData>
                </Button>
                <core:Icon src="sap-icon://slim-arrow-right" class="{= ${app>/stageStep} >= 8 ? 'quadsWfArrow quadsWfArrowDone' : 'quadsWfArrow' }" />

                <!-- 8. OUTCOME -->
                <Button
                    text="Outcome"
                    press=".onWorkflowStagePress"
                    class="{= ${app>/activeStep} === 8 ? 'quadsWfTab quadsWfActive' : (${app>/stageStep} > 8 ? 'quadsWfTab quadsWfPassed' : 'quadsWfTab quadsWfLocked') }">
                    <customData>
                        <core:CustomData key="step" value="8" />
                    </customData>
                </Button>

                <!-- Spacer -->
                <HBox class="quadsWfSpacer" />

                <!-- Audit Trail (separate, always accessible) -->
                <Button
                    text="Audit Trail"
                    icon="sap-icon://history"
                    press=".onWorkflowStagePress"
                    class="quadsWfTab quadsWfAudit">
                    <customData>
                        <core:CustomData key="step" value="9" />
                    </customData>
                </Button>

            </HBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>
