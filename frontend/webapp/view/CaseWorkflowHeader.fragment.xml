<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <VBox class="sapCaseWorkflowHeaderContainer">
        <!-- Top Row: Case ID · Title | Meta info right -->
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCaseHeaderTopRow">
            <HBox alignItems="Center">
                <Text text="{app>/selectedCaseId}" class="sapCaseHeaderId" />
                <Text text="·" class="sapCaseHeaderDot" />
                <Title text="{app>/caseTitle}" level="H3" class="sapCaseHeaderTitle" />
            </HBox>
            <HBox alignItems="Center" class="sapCaseHeaderMetaGroup">
                <Text text="Severity:" class="sapCaseMetaLabel sapUiTinyMarginEnd" />
                <ObjectStatus
                    text="{app>/caseSeverity}"
                    state="{= ${app>/caseSeverity} === 'CRITICAL' ? 'Error' : (${app>/caseSeverity} === 'HIGH' ? 'Warning' : 'Success') }"
                    class="sapUiSmallMarginEnd" />
                <Text text="Status:" class="sapCaseMetaLabel sapUiTinyMarginEnd" />
                <ObjectStatus
                    text="{app>/caseStatusText}"
                    state="Information"
                    class="sapUiSmallMarginEnd" />
                <Text text="{app>/lastUpdated}" class="textMuted textSmall" />
            </HBox>
        </HBox>

        <!-- Stage Progress Bar: 8 Stages, compact, no lock emoji clutter -->
        <HBox alignItems="Center" class="sapCaseStageIndicatorRow">

            <!-- 1. CASE -->
            <!-- 1. CASE -->
            <ObjectStatus
                text="Case"
                icon="{= ${app>/stageStep} > 1 ? 'sap-icon://accept' : (${app>/activeStep} === 1 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 1 ? 'sapStageNode active' : (${app>/stageStep} > 1 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="1" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 2. IMPACT ANALYSIS -->
            <ObjectStatus
                text="Impact Analysis"
                icon="{= ${app>/stageStep} > 2 ? 'sap-icon://accept' : (${app>/activeStep} === 2 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 2 ? 'sapStageNode active' : (${app>/stageStep} > 2 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="2" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 3. PRIORITY -->
            <ObjectStatus
                text="Priority"
                icon="{= ${app>/stageStep} > 3 ? 'sap-icon://accept' : (${app>/activeStep} === 3 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 3 ? 'sapStageNode active' : (${app>/stageStep} > 3 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="3" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 4. CONSTRAINTS -->
            <ObjectStatus
                text="Constraints"
                icon="{= ${app>/stageStep} > 4 ? 'sap-icon://accept' : (${app>/activeStep} === 4 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 4 ? 'sapStageNode active' : (${app>/stageStep} > 4 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="4" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 5. RECOVERY PLANNING -->
            <ObjectStatus
                text="Recovery Planning"
                icon="{= ${app>/stageStep} > 5 ? 'sap-icon://accept' : (${app>/activeStep} === 5 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 5 ? 'sapStageNode active' : (${app>/stageStep} > 5 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="5" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 6. DECISION -->
            <ObjectStatus
                text="Decision"
                icon="{= ${app>/stageStep} > 6 ? 'sap-icon://accept' : (${app>/activeStep} === 6 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 6 ? 'sapStageNode active' : (${app>/stageStep} > 6 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="6" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 7. EXECUTION & MONITORING -->
            <ObjectStatus
                text="Execution &amp; Monitoring"
                icon="{= ${app>/stageStep} > 7 ? 'sap-icon://accept' : (${app>/activeStep} === 7 ? 'sap-icon://circle-task' : 'sap-icon://circle-task-2') }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 7 ? 'sapStageNode active' : (${app>/stageStep} > 7 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="7" />
                </customData>
            </ObjectStatus>
            <core:Icon src="sap-icon://navigation-right-arrow" class="sapStageArrow" />

            <!-- 8. OUTCOME -->
            <ObjectStatus
                text="Outcome"
                icon="{= ${app>/stageStep} >= 8 ? (${app>/activeStep} === 8 ? 'sap-icon://circle-task' : 'sap-icon://accept') : 'sap-icon://circle-task-2' }"
                active="true"
                press=".onWorkflowStagePress"
                class="{= ${app>/activeStep} === 8 ? 'sapStageNode active' : (${app>/stageStep} >= 8 ? 'sapStageNode passed' : 'sapStageNode') }">
                <customData>
                    <core:CustomData key="step" value="8" />
                </customData>
            </ObjectStatus>
        </HBox>
    </VBox>
</core:FragmentDefinition>
