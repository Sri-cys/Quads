<mvc:View
    controllerName="com.quads.supplychain.controller.RecoveryPlanning"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="recoveryPlanningPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">

                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Context Subtitle + Action Buttons -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="RECOVERY PLAN GENERATION" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Agent 2 — Distinct Strategy Generation &amp; Agent 3 — Cost, Risk, Constraint &amp; Feasibility Evaluation" class="sapCorporatePageSubtitle bold" />
                    </VBox>
                    <HBox alignItems="Center">
                        <Link
                            text="&#x2190; Back to Recovery Priority"
                            press=".onBackToPriority"
                            class="sapBackLink sapUiMediumMarginEnd" />
                        <Button
                            id="btnProceedDecisionTop"
                            text="{= ${app>/completedStage} >= 5 ? 'GO TO FINAL DECISION &#x2192;' : 'PROCEED TO FINAL DECISION &#x2192;' }"
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press=".onProceedToDecision"
                            enabled="{= ${rec>/state} === 'COMPLETED' }"
                            class="sapBtnPrimary" />
                    </HBox>
                </HBox>

                <!-- Failure Banner (Visible on Error) -->
                <VBox
                    visible="{= ${rec>/state} === 'FAILED' }"
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #BB0000; background: #FFF5F5;">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://error" color="#BB0000" size="20px" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="Recovery planning failed" level="H3" class="bold textCritical" />
                                <Text text="{rec>/errorMessage}" class="textSmall textDark" />
                            </VBox>
                        </HBox>
                        <Button text="Retry" type="Reject" press=".onRefreshPlans" />
                    </HBox>
                </VBox>

                <!-- Compact Status Indicator -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsCompactStatusBar sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <core:Icon
                            src="{= ${rec>/state} === 'COMPLETED' ? 'sap-icon://accept' : 'sap-icon://synchronize' }"
                            color="{= ${rec>/state} === 'COMPLETED' ? '#107E3E' : '#0A6ED1' }"
                            size="16px"
                            class="sapUiTinyMarginEnd" />
                        <Text
                            text="{= ${rec>/state} === 'COMPLETED' ? (${rec>/candidates} ? ${rec>/candidates}.length : 0) + ' recovery plans generated · Evaluation completed' : (${rec>/agent3_status} === 'RUNNING' ? 'Evaluating candidate plans...' : 'Generating candidate plans...') }"
                            class="bold textSmall textDark" />
                    </HBox>
                    <ObjectStatus
                        text="{= ${rec>/state} === 'COMPLETED' ? 'EVALUATION COMPLETED' : (${rec>/agent3_status} === 'RUNNING' ? 'EVALUATING' : 'GENERATING') }"
                        state="{= ${rec>/state} === 'COMPLETED' ? 'Success' : 'Information' }"
                        class="bold textSmall" />
                </HBox>

                <!-- Content Area: Rendered when plans are available -->
                <VBox visible="{= ${rec>/candidates}.length > 0 || ${rec>/state} === 'COMPLETED' }">

                    <!-- Disruption & Strategy Context Bar -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCompactContextBar sapUiSmallMarginBottom">
                        <HBox alignItems="Center" wrap="Wrap" class="sapCompactContextList">
                            <VBox class="sapContextChip">
                                <Text text="CASE" class="sapContextChipLabel" />
                                <Text text="{rec>/case_id}" class="sapContextChipVal" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="RECOVERY OBJECTIVE" class="sapContextChipLabel" />
                                <Text text="{rec>/priority}" class="sapContextChipVal textPrimary bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="PLANS EVALUATED" class="sapContextChipLabel" />
                                <Text text="{rec>/total_plans_count} Plans" class="sapContextChipVal bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="FEASIBLE PLANS" class="sapContextChipLabel" />
                                <Text text="{= ${rec>/feasible_plans} ? ${rec>/feasible_plans}.length : 0 } Plans" class="sapContextChipVal textSuccess bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="NOT FEASIBLE" class="sapContextChipLabel" />
                                <Text text="{= ${rec>/infeasible_plans} ? ${rec>/infeasible_plans}.length : 0 } Plans" class="sapContextChipVal textCritical bold" />
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- AGENT 2 CANDIDATE RECOVERY PLANS GRID -->
                    <VBox class="sapUiSmallMarginBottom sapUiMediumMarginTop">
                        <VBox
                            id="candidatesGrid"
                            items="{rec>/candidates}"
                            renderType="Bare"
                            class="quadsPlanGrid sapUiSmallMarginBottom"
                            style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: stretch;">

                            <VBox class="sapChoiceCard quadsPlanCard">
                                <VBox>
                                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsCardHeaderRow">
                                    <Text text="{= ${rec>version} ? ${rec>plan_id} + ' (' + ${rec>version} + ')' : ${rec>plan_id} }" class="quadsPlanId bold" />
                                    <ObjectStatus text="PRE-EVALUATION" state="None" class="quadsPreEvalBadge textSmall" />
                                </HBox>

                                <Title text="{rec>strategy}" level="H3" class="quadsCardStrategy bold textDark" />
                                <Text text="Source: {rec>source_name} &#x2192; {rec>destination_name}" visible="{= !!${rec>source_name} || !!${rec>destination_name} }" class="quadsCardRoute textSmall textMuted" />

                                <HBox class="quadsCardMetaGrid sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <VBox class="quadsMetaCol">
                                        <VBox class="quadsMetaItem">
                                            <Text text="QUANTITY" class="quadsMetaLabel" />
                                            <Text text="{rec>recovered_quantity} Units" class="quadsMetaValue bold" />
                                        </VBox>
                                        <VBox class="quadsMetaItem sapUiTinyMarginTop">
                                            <Text text="ETA" class="quadsMetaLabel" />
                                            <Text text="{rec>expected_arrival_date}" visible="{= !!${rec>expected_arrival_date} }" class="quadsMetaValue" />
                                            <Text text="{rec>recovery_days} Days Lead Time" visible="{= !${rec>expected_arrival_date} }" class="quadsMetaValue" />
                                        </VBox>
                                    </VBox>
                                    <VBox class="quadsMetaCol">
                                        <VBox class="quadsMetaItem">
                                            <Text text="RECOVERY TIME" class="quadsMetaLabel" />
                                            <Text text="{rec>recovery_days} Days" class="quadsMetaValue bold textPrimary" />
                                        </VBox>
                                        <VBox class="quadsMetaItem sapUiTinyMarginTop">
                                            <Text text="MODE / CARRIER" class="quadsMetaLabel" />
                                            <Text text="{rec>transport_name}" class="quadsMetaValue" />
                                        </VBox>
                                    </VBox>
                                </HBox>

                                <VBox class="quadsMetaItem sapUiTinyMarginBottom">
                                    <Text text="CUSTOMER IMPACT" class="quadsMetaLabel" />
                                    <Text text="{rec>expected_customer_impact}" class="quadsMetaValue" />
                                </VBox>

                                </VBox>
                                <HBox alignItems="Center" justifyContent="End" class="sapUiSmallMarginTop" style="border-top: 1px solid #E5E5E5; padding-top: 12px;">
                                    <Button
                                        text="View Plan Details"
                                        type="Transparent"
                                        icon="sap-icon://inspect"
                                        press=".onInspectPlan" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- AGENT 3 PLAN EVALUATION & FEASIBILITY COMPARISON TABLE -->
                    <VBox class="sapUiMediumMarginTop sapUiMediumMarginBottom quadsImpactCard">
                        <Table items="{rec>/all_evaluated_plans}" class="quadsEvaluationTable sapUiSmallMarginBottom" noDataText="Evaluation running...">
                            <columns>
                                <Column width="160px"><Text text="Plan ID / Strategy" class="bold" /></Column>
                                <Column width="115px" minScreenWidth="Desktop" demandPopin="true"><Text text="Recovery Time" class="bold" /></Column>
                                <Column width="105px" minScreenWidth="Desktop" demandPopin="true"><Text text="ETA" class="bold" /></Column>
                                <Column width="115px"><Text text="Total Cost" class="bold" /></Column>
                                <Column width="100px"><Text text="Risk" class="bold" /></Column>
                                <Column width="125px" minScreenWidth="Desktop" demandPopin="true"><Text text="Customer Delay" class="bold" /></Column>
                                <Column width="115px" minScreenWidth="Tablet" demandPopin="true"><Text text="Qty Recovered" class="bold" /></Column>
                                <Column width="130px" minScreenWidth="Tablet" demandPopin="true"><Text text="Constraint Status" class="bold" /></Column>
                                <Column width="130px"><Text text="Feasibility" class="bold" /></Column>
                                <Column width="85px"><Text text="Score" class="bold" /></Column>
                                <Column width="180px"><Text text="Action" class="bold" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <VBox>
                                            <Text text="{= ${rec>version} ? ${rec>plan_id} + ' (' + ${rec>version} + ')' : ${rec>plan_id} }" class="bold textPrimary" />
                                            <Text text="{rec>strategy}" class="textSmall textMuted sapUiTinyMarginTop" />
                                        </VBox>
                                        <Text text="{rec>recovery_days} Days" class="bold" />
                                        <Text text="{rec>expected_arrival_date}" />
                                        <Text text="${= ${rec>total_cost} ? ${rec>total_cost}.toLocaleString() : 'N/A' }" class="bold" />
                                        <ObjectStatus
                                            text="{= ${rec>composite_risk_score} ? ${rec>operational_risk} + ' (' + ${rec>composite_risk_score} + ')' : ${rec>operational_risk} }"
                                            state="{= ${rec>operational_risk} === 'LOW' ? 'Success' : (${rec>operational_risk} === 'MEDIUM' ? 'Warning' : 'Error') }"
                                            class="bold" />
                                        <Text text="{rec>customer_delay_days} Days" class="{= ${rec>customer_delay_days} > 0 ? 'textCritical bold' : 'textSuccess bold' }" />
                                        <Text text="{rec>recovered_quantity} Units" />
                                        <ObjectStatus
                                            text="{= ${rec>is_feasible} ? 'Passed' : 'Breached' }"
                                            state="{= ${rec>is_feasible} ? 'Success' : 'Error' }"
                                            class="bold" />
                                        <VBox class="quadsFeasibilityCell">
                                            <ObjectStatus
                                                text="{= ${rec>is_feasible} ? 'FEASIBLE' : 'NOT FEASIBLE' }"
                                                state="{= ${rec>is_feasible} ? 'Success' : 'Error' }"
                                                class="bold" />
                                            <Text
                                                text="{rec>infeasibility_reason}"
                                                visible="{= !${rec>is_feasible} }"
                                                class="textCritical textSmall" />
                                        </VBox>
                                        <ObjectStatus
                                            text="{= ${rec>is_feasible} ? ${rec>score} + ' pts' : 'N/A' }"
                                            state="{= ${rec>score} >= 85 ? 'Success' : 'Information' }"
                                            class="bold" />
                                        <Button
                                            text="View Calculation Details"
                                            icon="sap-icon://inspection"
                                            press=".onInspectPlan"
                                            type="Default"
                                            class="sapUiTinyMarginTop" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- Rejected / Infeasible Alternatives Collapsible Panel -->
                    <Panel
                        expandable="true"
                        expanded="false"
                        headerText="Infeasible Alternatives ({= ${rec>/infeasible_plans} ? ${rec>/infeasible_plans}.length : 0 } Plans Filtered Out by Hard Constraints)"
                        class="sapUiSmallMarginTop sapContextCard">

                        <Table items="{rec>/infeasible_plans}" noDataText="No infeasible options identified.">
                            <columns>
                                <Column width="120px"><Text text="Plan ID" class="bold" /></Column>
                                <Column><Text text="Recovery Strategy" class="bold" /></Column>
                                <Column><Text text="Source" class="bold" /></Column>
                                <Column><Text text="Reason for Infeasibility" class="bold textCritical" /></Column>
                                <Column width="160px"><Text text="Constraint Breach" class="bold" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{rec>plan_id} ({rec>version})" class="bold" />
                                        <Text text="{rec>strategy}" />
                                        <Text text="{rec>source_name}" />
                                        <Text text="{rec>infeasibility_reason}" class="textCritical bold" />
                                        <ObjectStatus text="Hard Constraint Breach" state="Error" class="bold" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                    <!-- Bottom Action Row: Proceed to Stage 6 Final Decision -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageActionsRow sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button
                            text="Back to Recovery Priority"
                            type="Transparent"
                            icon="sap-icon://nav-back"
                            press=".onBackToPriority"
                            class="sapBtnSecondary" />
                        <HBox alignItems="Center">
                            <ObjectStatus text="Awaiting Human Authorization" state="Warning" class="bold sapUiMediumMarginEnd" />
                            <Button
                                id="btnProceedDecisionBottom"
                                text="{= ${app>/completedStage} >= 5 ? 'GO TO FINAL DECISION &#x2192;' : 'PROCEED TO FINAL DECISION &#x2192;' }"
                                icon="sap-icon://navigation-right-arrow"
                                type="Emphasized"
                                press=".onProceedToDecision"
                                enabled="{= ${rec>/state} === 'COMPLETED' }"
                                class="sapBtnPrimary" />
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
