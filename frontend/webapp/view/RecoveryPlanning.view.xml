<mvc:View
    controllerName="com.quads.supplychain.controller.RecoveryPlanning"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="recoveryPlanningPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">

                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Context Subtitle + Action Buttons -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="RECOVERY PLAN GENERATION" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Agent 2 — Distinct Strategy Generation &amp; Agent 3 — Cost, Risk, Constraint &amp; Feasibility Evaluation" class="sapCorporatePageSubtitle bold" />
                    </VBox>
                    <HBox alignItems="Center">
                        <Link
                            text="&#x2190; Back to Recovery Priority"
                            press=".onBackToPriority"
                            class="sapBackLink sapUiMediumMarginEnd" />
                        <Button
                            id="btnProceedDecisionTop"
                            text="PROCEED TO FINAL DECISION &#x2192;"
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press=".onProceedToDecision"
                            enabled="{= ${rec>/state} === 'COMPLETED' }"
                            class="sapBtnPrimary" />
                    </HBox>
                </HBox>

                <!-- Failure Banner (Visible on Error) -->
                <VBox
                    visible="{= ${rec>/state} === 'FAILED' }"
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #BB0000; background: #FFF5F5;">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://error" color="#BB0000" size="20px" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="Recovery planning failed" level="H3" class="bold textCritical" />
                                <Text text="{rec>/errorMessage}" class="textSmall textDark" />
                            </VBox>
                        </HBox>
                        <Button text="Retry" type="Reject" press=".onRefreshPlans" />
                    </HBox>
                </VBox>

                <!-- Continuous Flow Status Banner (Agent 2 -> Agent 3) -->
                <VBox
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #0A6ED1; background: #F0F7FF; padding: 18px 24px;">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center">
                            <core:Icon
                                src="{= ${rec>/agent2_status} === 'COMPLETED' ? 'sap-icon://accept' : 'sap-icon://synchronize' }"
                                color="{= ${rec>/agent2_status} === 'COMPLETED' ? '#107E3E' : '#0A6ED1' }"
                                size="18px"
                                class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title
                                    text="{= ${rec>/agent2_status} === 'COMPLETED' ? '✓ Agent 2 Completed: ' + (${rec>/candidates} ? ${rec>/candidates}.length : 0) + ' candidate recovery plans generated' : '● Agent 2: Generating candidate recovery alternatives...' }"
                                    level="H3"
                                    class="{= ${rec>/agent2_status} === 'COMPLETED' ? 'bold textSuccess' : 'bold textPrimary' }" />
                                <Text
                                    text="{= ${rec>/agent3_status} === 'COMPLETED' ? '✓ Agent 3 Completed: Plan-specific cost, multi-dimensional risk, contracts and feasibility evaluated' : (${rec>/agent3_status} === 'RUNNING' ? '● Agent 3: Evaluating candidate plans (Cost, Risk, Constraints, Feasibility)...' : 'Agent 3 automatically chains upon candidate generation') }"
                                    class="{= ${rec>/agent3_status} === 'COMPLETED' ? 'bold textSuccess textSmall' : (${rec>/agent3_status} === 'RUNNING' ? 'bold textPrimary textSmall' : 'textMuted textSmall') }" />
                            </VBox>
                        </HBox>
                        <ObjectStatus
                            text="{= ${rec>/state} === 'COMPLETED' ? 'EVALUATION COMPLETED' : (${rec>/agent3_status} === 'RUNNING' ? 'EVALUATING PLANS' : 'GENERATING PLANS') }"
                            state="{= ${rec>/state} === 'COMPLETED' ? 'Success' : 'Information' }"
                            inverted="true"
                            class="bold" />
                    </HBox>
                </VBox>

                <!-- Content Area: Rendered when plans are available -->
                <VBox visible="{= ${rec>/candidates}.length > 0 || ${rec>/state} === 'COMPLETED' }">

                    <!-- Disruption & Strategy Context Bar -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCompactContextBar sapUiSmallMarginBottom">
                        <HBox alignItems="Center" wrap="Wrap" class="sapCompactContextList">
                            <VBox class="sapContextChip">
                                <Text text="CASE" class="sapContextChipLabel" />
                                <Text text="{rec>/case_id}" class="sapContextChipVal" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="RECOVERY OBJECTIVE" class="sapContextChipLabel" />
                                <Text text="{rec>/priority}" class="sapContextChipVal textPrimary bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="PLANS EVALUATED" class="sapContextChipLabel" />
                                <Text text="{rec>/total_plans_count} Plans" class="sapContextChipVal bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="FEASIBLE PLANS" class="sapContextChipLabel" />
                                <Text text="{= ${rec>/feasible_plans} ? ${rec>/feasible_plans}.length : 0 } Plans" class="sapContextChipVal textSuccess bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="NOT FEASIBLE" class="sapContextChipLabel" />
                                <Text text="{= ${rec>/infeasible_plans} ? ${rec>/infeasible_plans}.length : 0 } Plans" class="sapContextChipVal textCritical bold" />
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- SECTION 1: AGENT 2 CANDIDATE RECOVERY PLANS -->
                    <VBox class="sapUiSmallMarginBottom">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <VBox>
                                <Title text="Candidate Recovery Plans (Agent 2)" level="H2" class="sapSectionTitle" />
                                <Text text="3–6 distinct operational recovery options generated from network topology and available carriers. Cost and time values are pre-evaluation estimates." class="sapSectionSub" />
                            </VBox>
                            <ObjectStatus text="Agent 2 Output" state="Information" class="bold" />
                        </HBox>

                        <layout:Grid
                            id="candidatesGrid"
                            defaultSpan="XL4 L4 M6 S12"
                            hSpacing="1"
                            vSpacing="1"
                            content="{rec>/candidates}">

                            <VBox class="sapChoiceCard sapRecoveryPlanCard">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <ObjectStatus text="{rec>plan_id} ({rec>version})" state="Information" inverted="true" class="bold" />
                                    <ObjectStatus text="Estimate (pre-evaluation)" state="Warning" class="bold textSmall" />
                                </HBox>

                                <Title text="{rec>strategy}" level="H3" class="bold textDark sapUiTinyMarginBottom" />
                                <Text text="Source: {rec>source_name} &#x2192; {rec>destination_name}" class="textSmall bold sapUiTinyMarginBottom" />

                                <layout:Grid defaultSpan="XL6 L6 M6 S6" hSpacing="0.5" vSpacing="0.5" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <VBox class="sapMetricBox">
                                        <Text text="Quantity" class="sapContextItemLabel" />
                                        <Text text="{rec>recovered_quantity} Units" class="bold textMedium" />
                                    </VBox>
                                    <VBox class="sapMetricBox">
                                        <Text text="Mode / Carrier" class="sapContextItemLabel" />
                                        <Text text="{rec>transport_name}" class="bold textMedium" />
                                    </VBox>
                                    <VBox class="sapMetricBox">
                                        <Text text="Estimated Lead Time" class="sapContextItemLabel" />
                                        <Text text="{rec>recovery_days} Days" class="bold textMedium textPrimary" />
                                        <Text text="Estimate (pre-evaluation)" class="textMuted textSmall" />
                                    </VBox>
                                    <VBox class="sapMetricBox">
                                        <Text text="Customer Impact" class="sapContextItemLabel" />
                                        <Text text="{rec>expected_customer_impact}" class="bold textMedium" />
                                        <Text text="Estimate (pre-evaluation)" class="textMuted textSmall" />
                                    </VBox>
                                </layout:Grid>

                                <HBox alignItems="Center" justifyContent="End" class="sapUiSmallMarginTop">
                                    <Button
                                        text="View Plan Details"
                                        type="Transparent"
                                        icon="sap-icon://inspect"
                                        press=".onInspectPlan" />
                                </HBox>
                            </VBox>
                        </layout:Grid>
                    </VBox>

                    <!-- SECTION 2: AGENT 3 PLAN EVALUATION & FEASIBILITY COMPARISON TABLE -->
                    <VBox class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <VBox>
                                <Title text="PLAN EVALUATION &amp; FEASIBILITY (AGENT 3)" level="H2" class="sapSectionTitle" />
                                <Text text="Deterministic evaluation of candidate plans: plan-specific recovery cost, multi-dimensional risk, contract validation, and hard/soft constraints." class="sapSectionSub" />
                            </VBox>
                            <Text text="NO AUTOMATIC APPROVAL — Human Decision Required in Stage 6" class="bold textCritical" />
                        </HBox>

                        <Table items="{rec>/all_evaluated_plans}" class="sapUiSmallMarginBottom" noDataText="Evaluation running...">
                            <columns>
                                <Column width="140px"><Text text="Plan ID / Strategy" class="bold" /></Column>
                                <Column width="110px"><Text text="Recovery Time" class="bold" /></Column>
                                <Column width="110px"><Text text="ETA" class="bold" /></Column>
                                <Column width="110px"><Text text="Total Cost" class="bold" /></Column>
                                <Column width="110px"><Text text="Risk" class="bold" /></Column>
                                <Column width="110px"><Text text="Customer Delay" class="bold" /></Column>
                                <Column width="110px"><Text text="Qty Recovered" class="bold" /></Column>
                                <Column width="130px"><Text text="Constraint Status" class="bold" /></Column>
                                <Column width="130px"><Text text="Feasibility" class="bold" /></Column>
                                <Column width="90px"><Text text="Score" class="bold" /></Column>
                                <Column width="150px"><Text text="Action" class="bold" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <VBox>
                                            <Text text="{rec>plan_id} ({rec>version})" class="bold textPrimary" />
                                            <Text text="{rec>strategy}" class="textSmall textMuted" />
                                        </VBox>
                                        <Text text="{rec>recovery_days} Days" class="bold" />
                                        <Text text="{rec>expected_arrival_date}" />
                                        <Text text="${= ${rec>total_cost} ? ${rec>total_cost}.toLocaleString() : 'N/A' }" class="bold" />
                                        <ObjectStatus
                                            text="{rec>operational_risk} ({rec>composite_risk_score})"
                                            state="{= ${rec>operational_risk} === 'LOW' ? 'Success' : (${rec>operational_risk} === 'MEDIUM' ? 'Warning' : 'Error') }"
                                            class="bold" />
                                        <Text text="{rec>customer_delay_days} Days" class="{= ${rec>customer_delay_days} > 0 ? 'textCritical bold' : 'textSuccess bold' }" />
                                        <Text text="{rec>recovered_quantity} Units" />
                                        <ObjectStatus
                                            text="{= ${rec>is_feasible} ? 'Passed' : 'Breached' }"
                                            state="{= ${rec>is_feasible} ? 'Success' : 'Error' }"
                                            class="bold" />
                                        <VBox>
                                            <ObjectStatus
                                                text="{= ${rec>is_feasible} ? 'FEASIBLE' : 'NOT FEASIBLE' }"
                                                state="{= ${rec>is_feasible} ? 'Success' : 'Error' }"
                                                class="bold" />
                                            <Text
                                                text="{rec>infeasibility_reason}"
                                                visible="{= !${rec>is_feasible} }"
                                                class="textCritical textSmall bold" />
                                        </VBox>
                                        <ObjectStatus
                                            text="{= ${rec>is_feasible} ? ${rec>score} + ' pts' : 'N/A' }"
                                            state="{= ${rec>score} >= 85 ? 'Success' : 'Information' }"
                                            class="bold" />
                                        <Button
                                            text="CALCULATION DETAILS"
                                            icon="sap-icon://inspection"
                                            press=".onInspectPlan"
                                            type="Default" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- Rejected / Infeasible Alternatives Collapsible Panel -->
                    <Panel
                        expandable="true"
                        expanded="false"
                        headerText="Infeasible Alternatives ({= ${rec>/infeasible_plans} ? ${rec>/infeasible_plans}.length : 0 } Plans Filtered Out by Hard Constraints)"
                        class="sapUiSmallMarginTop sapContextCard">

                        <Table items="{rec>/infeasible_plans}" noDataText="No infeasible options identified.">
                            <columns>
                                <Column width="120px"><Text text="Plan ID" class="bold" /></Column>
                                <Column><Text text="Recovery Strategy" class="bold" /></Column>
                                <Column><Text text="Source" class="bold" /></Column>
                                <Column><Text text="Reason for Infeasibility" class="bold textCritical" /></Column>
                                <Column width="160px"><Text text="Constraint Breach" class="bold" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{rec>plan_id} ({rec>version})" class="bold" />
                                        <Text text="{rec>strategy}" />
                                        <Text text="{rec>source_name}" />
                                        <Text text="{rec>infeasibility_reason}" class="textCritical bold" />
                                        <ObjectStatus text="Hard Constraint Breach" state="Error" class="bold" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                    <!-- Bottom Action Row: Proceed to Stage 6 Final Decision -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageActionsRow sapUiSmallMarginTop">
                        <Button
                            text="Back to Recovery Priority"
                            type="Transparent"
                            icon="sap-icon://nav-back"
                            press=".onBackToPriority"
                            class="sapBtnSecondary" />
                        <Button
                            id="btnProceedDecisionBottom"
                            text="PROCEED TO FINAL DECISION &#x2192;"
                            icon="sap-icon://navigation-right-arrow"
                            type="Emphasized"
                            press=".onProceedToDecision"
                            enabled="{= ${rec>/state} === 'COMPLETED' }"
                            class="sapBtnPrimary" />
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
