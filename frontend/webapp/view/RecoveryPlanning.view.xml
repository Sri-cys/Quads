<mvc:View
    controllerName="com.quads.supplychain.controller.RecoveryPlanning"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="recoveryPlanningPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">

                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Context Subtitle + Action Buttons -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="RECOVERY PLANNING — AGENT 3" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Multi-agent candidate strategy generation, historical precedent matching, constraint validation, and feasible plan ranking." class="sapCorporatePageSubtitle" />
                    </VBox>
                    <HBox alignItems="Center">
                        <Link
                            text="&#x2190; Back to Constraints"
                            press=".onBackToConstraints"
                            class="sapBackLink sapUiMediumMarginEnd" />
                        <Button
                            icon="sap-icon://refresh"
                            text="Re-Generate Plans"
                            type="Default"
                            press=".onRefreshPlans"
                            tooltip="Re-run Agent 3 strategy generation"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnProceedDecisionTop"
                            text="PROCEED TO FINAL DECISION &#x2192;"
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press=".onProceedToDecision"
                            enabled="{= ${rec>/feasible_plans}.length > 0 }"
                            class="sapBtnPrimary" />
                    </HBox>
                </HBox>

                <!-- Failure Banner (Visible on Error) -->
                <VBox
                    visible="{= ${rec>/state} === 'FAILED' }"
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #BB0000; background: #FFF5F5;">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://error" color="#BB0000" size="20px" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="Recovery planning failed" level="H3" class="bold textCritical" />
                                <Text text="{rec>/errorMessage}" class="textSmall textDark" />
                            </VBox>
                        </HBox>
                        <Button text="Retry" type="Reject" press=".onRefreshPlans" />
                    </HBox>
                </VBox>

                <!-- Running Indicator Banner -->
                <VBox
                    visible="{= ${rec>/state} === 'RUNNING' }"
                    class="sapChoiceCard sapUiSmallMarginBottom"
                    style="border-left: 4px solid #0A6ED1; background: #F0F7FF;">
                    <HBox alignItems="Center">
                        <BusyIndicator size="1.2rem" class="sapUiSmallMarginEnd" />
                        <VBox>
                            <Title text="Agent 3: Generating recovery plans..." level="H3" class="bold textPrimary" />
                            <Text text="Querying alternative suppliers, matching historical disruption cases, validating plant capacity corridors, and scoring recovery combinations." class="textSmall textDark" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Content Area: Rendered when COMPLETED -->
                <VBox visible="{= ${rec>/state} === 'COMPLETED' }">

                    <!-- Disruption & Strategy Context Bar -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCompactContextBar sapUiSmallMarginBottom">
                        <HBox alignItems="Center" wrap="Wrap" class="sapCompactContextList">
                            <VBox class="sapContextChip">
                                <Text text="CASE" class="sapContextChipLabel" />
                                <Text text="{rec>/case_id}" class="sapContextChipVal" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="RECOVERY OBJECTIVE" class="sapContextChipLabel" />
                                <Text text="{rec>/priority}" class="sapContextChipVal textPrimary bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="AFFECTED MATERIAL" class="sapContextChipLabel" />
                                <Text text="{rec>/material_name} ({rec>/material_id})" class="sapContextChipVal bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="TARGET VOLUME" class="sapContextChipLabel" />
                                <Text text="{rec>/target_quantity} Units" class="sapContextChipVal textWarning bold" />
                            </VBox>
                            <VBox class="sapContextChip">
                                <Text text="DAYS OF COVER" class="sapContextChipLabel" />
                                <Text text="{rec>/days_of_cover} Days" class="sapContextChipVal bold" />
                            </VBox>
                        </HBox>
                        <HBox alignItems="Center">
                            <Label text="Selected Plan:" class="bold sapUiTinyMarginEnd" />
                            <ObjectStatus
                                text="{= ${rec>/selectedPlanId} ? ${rec>/selectedPlanId} + ' (' + ${rec>/selectedPlanVersion} + ')' : 'None Selected' }"
                                state="{= ${rec>/selectedPlanId} ? 'Success' : 'Warning' }"
                                class="bold" />
                        </HBox>
                    </HBox>

                    <!-- Executive Recovery Briefing Banner -->
                    <VBox class="sapContextCard sapUiSmallMarginBottom">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://lightbulb" class="sapContextIcon" color="#0A6ED1" />
                                <Title text="AGENT 3 STRATEGIC SYNTHESIS &amp; HISTORICAL PRECEDENTS" level="H3" class="sapCardSectionTitle sapUiTinyMarginBegin" />
                            </HBox>
                            <ObjectStatus
                                text="{= ${rec>/ai_status} === 'AVAILABLE' ? 'AI Grounded Analysis' : 'Deterministic Precedent Synthesis' }"
                                state="{= ${rec>/ai_status} === 'AVAILABLE' ? 'Success' : 'Information' }"
                                class="bold" />
                        </HBox>
                        <Text text="{rec>/ai_briefing}" class="sapUiTinyMarginTop textSmall lineClamped" />
                    </VBox>

                    <!-- Feasible Recovery Plans Section Header -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                        <VBox>
                            <Title text="Ranked Feasible Recovery Alternatives" level="H2" class="sapSectionTitle" />
                            <Text text="Generated combinations tested against Agent 2 hard constraints and scored by '{rec>/priority}' objective." class="sapSectionSub" />
                        </VBox>
                        <Text text="NO AUTOMATIC APPROVAL — Human Decision Required in Stage 6" class="bold textCritical" />
                    </HBox>

                    <!-- Feasible Plans Grid (2 Columns on Desktop) -->
                    <layout:Grid
                        id="feasiblePlansGrid"
                        defaultSpan="XL6 L6 M12 S12"
                        hSpacing="1"
                        vSpacing="1"
                        content="{rec>/feasible_plans}">

                        <VBox class="sapChoiceCard sapRecoveryPlanCard">

                            <!-- Selected Plan Indicator Banner -->
                            <HBox
                                visible="{= ${rec>plan_id} === ${rec>/selectedPlanId} }"
                                alignItems="Center"
                                class="sapPlanSelectedBanner sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://accept" class="sapUiTinyMarginEnd textPrimary" />
                                <Text text="Selected Candidate for Final Decision" class="bold textPrimary textSmall" />
                            </HBox>

                            <!-- Card Header: Plan ID Badge and Score -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <ObjectStatus
                                        text="{rec>plan_id}"
                                        state="Information"
                                        inverted="true"
                                        class="bold sapUiTinyMarginEnd" />
                                    <ObjectStatus
                                        text="{= ${rec>score} >= 85 ? 'Top Recommendation' : 'Alternative Strategy' }"
                                        state="{= ${rec>score} >= 85 ? 'Success' : 'None' }"
                                        class="bold" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapPlanScoreBox">
                                    <Text text="Score: " class="sapContextItemLabel" />
                                    <Text text="{rec>score}" class="bold textLarge textPrimary" />
                                </HBox>
                            </HBox>

                            <!-- Plan Title -->
                            <Title text="{rec>title}" level="H3" wrapping="true" class="bold textDark sapUiTinyMarginBottom" />

                            <!-- Strategy & Source -->
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <ObjectStatus
                                    text="{rec>strategy}"
                                    state="Information"
                                    class="bold sapUiTinyMarginEnd" />
                                <Text text="Source: {rec>source_name} ({rec>source_location})" class="textMuted textSmall" />
                            </HBox>

                            <!-- Key Metrics Grid (3 Columns) -->
                            <layout:Grid
                                defaultSpan="XL4 L4 M4 S12"
                                hSpacing="0.5"
                                vSpacing="0.5"
                                class="sapUiTinyMarginTop sapUiTinyMarginBottom">

                                <VBox class="sapMetricBox">
                                    <Text text="Recovery Lead Time" class="sapContextItemLabel" />
                                    <Text text="{rec>recovery_days} Days" class="bold textLarge textPrimary" />
                                </VBox>

                                <VBox class="sapMetricBox">
                                    <Text text="Fulfillment Quantity" class="sapContextItemLabel" />
                                    <Text text="{rec>recovered_quantity} Units" class="bold textLarge" />
                                </VBox>

                                <VBox class="sapMetricBox">
                                    <Text text="Total Recovery Cost" class="sapContextItemLabel" />
                                    <Text text="${= ${rec>total_cost} ? ${rec>total_cost}.toLocaleString() : '0' }" class="bold textLarge" />
                                </VBox>
                            </layout:Grid>

                            <!-- Transport & Risk -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://shipping-status" class="sapUiTinyMarginEnd textPrimary" />
                                    <Text text="{rec>transport_name}" class="bold textDark" />
                                </HBox>
                                <ObjectStatus
                                    text="{rec>operational_risk} RISK"
                                    state="{= ${rec>operational_risk} === 'LOW' ? 'Success' : (${rec>operational_risk} === 'MEDIUM' ? 'Warning' : 'Error') }"
                                    class="bold textSmall" />
                            </HBox>

                            <!-- Performance Breakdown Summary -->
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <Text text="Speed: {rec>score_breakdown/time_score}" class="textSmall bold" />
                                <Text text="Cost: {rec>score_breakdown/cost_score}" class="textSmall bold" />
                                <Text text="Safety: {rec>score_breakdown/risk_score}" class="textSmall bold" />
                                <Text text="Fulfillment: {rec>score_breakdown/fulfillment_score}" class="textSmall bold" />
                            </HBox>

                            <!-- Validation Tag -->
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                <ObjectStatus
                                    text="&#x2713; Feasible &amp; Validated"
                                    state="Success"
                                    class="textSmall bold" />
                            </HBox>

                            <!-- Collapsible Score Rationale -->
                            <Panel
                                expandable="true"
                                expanded="false"
                                headerText="View Scoring Rationale &#x25BE;"
                                class="sapRationalePanel sapUiTinyMarginTop">
                                <VBox>
                                    <Text text="{rec>score_breakdown/explanation}" class="textSmall" />
                                </VBox>
                            </Panel>

                            <!-- Card Action Buttons -->
                            <HBox alignItems="Center" justifyContent="End" class="sapUiSmallMarginTop">
                                <Button
                                    text="Inspect Details"
                                    type="Transparent"
                                    icon="sap-icon://inspect"
                                    press=".onInspectPlan"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="{= ${rec>plan_id} === ${rec>/selectedPlanId} ? 'Selected &#x2713;' : 'Select for Decision' }"
                                    type="{= ${rec>plan_id} === ${rec>/selectedPlanId} ? 'Emphasized' : 'Default' }"
                                    icon="{= ${rec>plan_id} === ${rec>/selectedPlanId} ? 'sap-icon://accept' : 'sap-icon://cursor-arrow' }"
                                    press=".onSelectPlan" />
                            </HBox>
                        </VBox>
                    </layout:Grid>

                    <!-- Rejected / Infeasible Alternatives Collapsible Panel -->
                    <Panel
                        expandable="true"
                        expanded="false"
                        headerText="Rejected / Infeasible Alternatives ({= ${rec>/infeasible_plans} ? ${rec>/infeasible_plans}.length : 0 } Options Filtered Out)"
                        class="sapUiSmallMarginTop sapContextCard">

                        <Table items="{rec>/infeasible_plans}" noDataText="No infeasible options identified.">
                            <columns>
                                <Column width="120px"><Text text="Plan ID" class="bold" /></Column>
                                <Column><Text text="Recovery Strategy" class="bold" /></Column>
                                <Column><Text text="Source" class="bold" /></Column>
                                <Column><Text text="Reason for Infeasibility" class="bold textCritical" /></Column>
                                <Column width="160px"><Text text="Violated Constraint" class="bold" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{rec>plan_id} ({rec>version})" class="bold" />
                                        <Text text="{rec>strategy}" />
                                        <Text text="{rec>source_name}" />
                                        <Text text="{rec>infeasibility_reason}" class="textCritical bold" />
                                        <ObjectStatus text="Hard Constraint Breach" state="Error" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>

                    <!-- Bottom Action Row: Proceed to Stage 6 Final Decision -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageActionsRow sapUiSmallMarginTop">
                        <Button
                            text="Back to Constraints"
                            type="Transparent"
                            icon="sap-icon://nav-back"
                            press=".onBackToConstraints"
                            class="sapBtnSecondary" />
                        <Button
                            id="btnProceedDecisionBottom"
                            text="PROCEED TO FINAL DECISION &#x2192;"
                            icon="sap-icon://navigation-right-arrow"
                            type="Emphasized"
                            press=".onProceedToDecision"
                            enabled="{= ${rec>/feasible_plans}.length > 0 }"
                            class="sapBtnPrimary" />
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
