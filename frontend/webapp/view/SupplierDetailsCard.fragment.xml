<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="sapFioriSection">
        <HBox alignItems="Center" class="sapFioriSectionHeader">
            <Text text="2" class="sapSectionNum" />
            <Title text="Supplier Details" level="H2" class="sapFioriSectionTitle" />
        </HBox>
        <VBox class="sapFioriSectionBody">
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Supplier Name" class="quadsDetailLabel" />
                <Text text="{case>/supplier_name} ({case>/supplier_id})" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Supplier Reliability" class="quadsDetailLabel" />
                <Text text="{case>/supplier/reliabilityScore}%" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="On-Time Delivery (OTD)" class="quadsDetailLabel" />
                <Text text="{case>/supplier/otdScore}%" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Open POs" class="quadsDetailLabel" />
                <Text text="{case>/supplier/openPos} (500 units)" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Current Shipment" class="quadsDetailLabel" />
                <Text text="In Transit" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Expected Delivery" class="quadsDetailLabel" />
                <Text text="{case>/expected_delivery_date}" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Delay" class="quadsDetailLabel" />
                <Text text="+{case>/expected_delay_days} days" class="quadsDetailValueCritical" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Supplier Capacity" class="quadsDetailLabel" />
                <Text text="Normal" class="quadsDetailValue" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Supplier Risk" class="quadsDetailLabel" />
                <ObjectStatus text="{case>/supplier/riskTier}" class="quadsBadgeWarning" />
            </HBox>
            <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                <Text text="Recent Performance" class="quadsDetailLabel" />
                <Text text="2 delays in last 6 months" class="quadsDetailValue" />
            </HBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>
