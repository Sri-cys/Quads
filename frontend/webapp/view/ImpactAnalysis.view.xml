<mvc:View
    controllerName="com.quads.supplychain.controller.ImpactAnalysis"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="impactPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">
                
                <!-- BREADCRUMBS -->
                <HBox alignItems="Center" class="quadsBreadcrumbRow sapUiSmallMarginBottom">
                    <Link text="&#x2190; Back to Cases" press=".onNavBackToCaseOverview" class="quadsBreadcrumbLink" />
                    <Text text="&#160;/&#160;" class="quadsBreadcrumbText" />
                    <Text text="{impact>/case/case_id}" class="quadsBreadcrumbLink" />
                    <Text text="&#160;/&#160;" class="quadsBreadcrumbText" />
                    <Text text="Impact Analysis" class="quadsBreadcrumbActive" />
                </HBox>


                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Context Subtitle + Conditional Action Buttons -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="Impact Analysis" level="H1" class="sapCorporatePageTitle" />
                        <Text text="{impact>/case/case_id} · Agent 1 — Deterministic &amp; Cross-Functional Disruption Triage" class="sapCorporatePageSubtitle" />
                    </VBox>
                    <HBox alignItems="Center">
                        <Link
                            text="&#x2190; Back to Case Overview"
                            press=".onNavBackToCaseOverview"
                            class="sapBackLink sapUiMediumMarginEnd" />

                        <!-- Running State Indicator -->
                        <Button
                            text="ANALYSIS IN PROGRESS..."
                            type="Default"
                            icon="sap-icon://synchronize"
                            enabled="false"
                            visible="{= ${impact>/analysisState} === 'RUNNING' }"
                            class="sapUiTinyMarginEnd" />

                        <!-- Failed State Button -->
                        <Button
                            text="RETRY ANALYSIS"
                            type="Reject"
                            icon="sap-icon://refresh"
                            press=".onRetryImpactAnalysis"
                            visible="{= ${impact>/analysisState} === 'FAILED' }"
                            class="sapUiTinyMarginEnd" />

                        <!-- Completed State Buttons -->
                        <Button
                            id="btnProceedPriorityTop"
                            text="PROCEED TO RECOVERY PRIORITY &#x2192;"
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press=".onProceedPriority"
                            visible="{= ${impact>/analysisState} === 'COMPLETED' }"
                            class="sapBtnPrimary" />
                    </HBox>
                </HBox>
                <!-- HEADER CARD -->
                <HBox class="quadsWhiteCard quadsHeaderCard sapUiSmallMarginBottom" alignItems="Center" justifyContent="SpaceBetween">
                    <!-- Left Side -->
                    <HBox alignItems="Center" class="quadsHeaderLeft">
                        <VBox class="quadsHeaderWarningIconBox sapUiSmallMarginEnd" justifyContent="Center" alignItems="Center">
                            <core:Icon src="sap-icon://alert" class="quadsHeaderWarningIcon" />
                        </VBox>
                        <VBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <Title text="{impact>/case/case_id}" class="quadsHeaderTitle sapUiSmallMarginEnd" />
                                <ObjectStatus text="{impact>/deterministic/severity} Impact" class="quadsHeaderBadgeCritical" />
                            </HBox>
                            <Text text="{impact>/case/disruption_name}" class="quadsHeaderSubtitle" />
                        </VBox>
                    </HBox>
                    
                    <!-- Right Side: Grid of Metadata -->
                    <HBox alignItems="Center" class="quadsHeaderRight" renderType="Bare">
                        <VBox class="quadsHeaderMetaBox" renderType="Bare">
                            <Text text="Supplier" class="quadsMetaLabel" wrapping="false" />
                            <Text text="{impact>/supplier/name}" class="quadsMetaValueMain" />
                            <Text text="({impact>/supplier/id})" class="quadsMetaValueSub" />
                        </VBox>
                        <VBox class="quadsHeaderMetaDivider" />
                        <VBox class="quadsHeaderMetaBox">
                            <Text text="Material" class="quadsMetaLabel" />
                            <Text text="{impact>/case/material_id}" class="quadsMetaValueMain" />
                            <Text text="(Hydraulic Pump)" class="quadsMetaValueSub" />
                        </VBox>
                        <VBox class="quadsHeaderMetaDivider" />
                        <VBox class="quadsHeaderMetaBox">
                            <Text text="Plant" class="quadsMetaLabel" />
                            <Text text="{impact>/production/plantId}" class="quadsMetaValueMain" />
                            <Text text="({impact>/production/plantName})" class="quadsMetaValueSub" />
                        </VBox>
                        <VBox class="quadsHeaderMetaDivider" />
                        <VBox class="quadsHeaderMetaBox">
                            <Text text="Disruption Type" class="quadsMetaLabel" />
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://shipping-status" class="quadsMetaIcon sapUiTinyMarginEnd" />
                                <Text text="{impact>/case/disruption_type}" class="quadsMetaValueMain" />
                            </HBox>
                        </VBox>
                        <VBox class="quadsHeaderMetaDivider" />
                        <VBox class="quadsHeaderMetaBox">
                            <Text text="Created On" class="quadsMetaLabel" />
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://calendar" class="quadsMetaIcon sapUiTinyMarginEnd" />
                                <VBox>
                                    <Text text="27 Sep 2026" class="quadsMetaValueMain" />
                                    <Text text="10:24 AM" class="quadsMetaValueSub" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox class="quadsHeaderMetaDivider" />
                        <VBox class="quadsHeaderMetaBox">
                            <Text text="Current Status" class="quadsMetaLabel" />
                            <ObjectStatus text="Impact Analysis" class="quadsStatusBadgeWarning sapUiTinyMarginBottom" />
                            <HBox alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://sys-enter-2" class="quadsStatusIconSuccess sapUiTinyMarginEnd" />
                                <Text text="Completed" class="quadsStatusText" wrapping="false" />
                            </HBox>
                        </VBox>

                    </HBox>
                </HBox>

                <!-- TOP KPI CARDS (4 COLUMNS) -->
                <HBox class="quadsImpact4Grid sapUiSmallMarginBottom">
                    <!-- Days of Cover -->
                    <HBox class="quadsWhiteCard quadsKpiCard" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
                        <HBox alignItems="Center" class="quadsKpiLeft" renderType="Bare">
                            <VBox class="quadsKpiIconBox blue" justifyContent="Center" alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://product" />
                            </VBox>
                            <VBox renderType="Bare">
                                <Text text="Days of Cover" class="quadsKpiTitle" wrapping="false" />
                                <Text text="{impact>/inventory/daysOfCover_formatted}" class="quadsKpiValueCritical" wrapping="false" />
                                <Text text="Safety stock breached" class="quadsKpiSub" wrapping="false" />
                            </VBox>
                        </HBox>
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsKpiArrow" />
                    </HBox>
                    
                    <!-- Projected Stockout Date -->
                    <HBox class="quadsWhiteCard quadsKpiCard" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
                        <HBox alignItems="Center" class="quadsKpiLeft" renderType="Bare">
                            <VBox class="quadsKpiIconBox blue" justifyContent="Center" alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://calendar" />
                            </VBox>
                            <VBox renderType="Bare">
                                <Text text="Projected Stockout Date" class="quadsKpiTitle" wrapping="false" />
                                <Text text="{impact>/inventory/stockoutDate_formatted}" class="quadsKpiValueDark" wrapping="false" />
                                <Text text="In 5 days" class="quadsKpiSub" wrapping="false" />
                            </VBox>
                        </HBox>
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsKpiArrow" />
                    </HBox>
                    
                    <!-- Supply Gap -->
                    <HBox class="quadsWhiteCard quadsKpiCard borderCritical" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
                        <HBox alignItems="Center" class="quadsKpiLeft" renderType="Bare">
                            <VBox class="quadsKpiIconBox red" justifyContent="Center" alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://alert" />
                            </VBox>
                            <VBox renderType="Bare">
                                <Text text="Supply Gap" class="quadsKpiTitle" wrapping="false" />
                                <Text text="{impact>/inventory/supplyGap_formatted}" class="quadsKpiValueCritical" wrapping="false" />
                                <Text text="vs. required 500 units" class="quadsKpiSub" wrapping="false" />
                            </VBox>
                        </HBox>
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsKpiArrow" />
                    </HBox>
                    
                    <!-- Severity Assessment -->
                    <HBox class="quadsWhiteCard quadsKpiCard" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
                        <HBox alignItems="Center" class="quadsKpiLeft" renderType="Bare">
                            <VBox class="quadsKpiIconBox blue" justifyContent="Center" alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://bar-chart" />
                            </VBox>
                            <VBox renderType="Bare">
                                <Text text="Severity Assessment" class="quadsKpiTitle" wrapping="false" />
                                <Text text="{impact>/deterministic/severity}" class="quadsKpiValueCritical" wrapping="false" />
                                <Text text="Production &amp; Financial Impact" class="quadsKpiSub" wrapping="false" />
                            </VBox>
                        </HBox>
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsKpiArrow" />
                    </HBox>
                </HBox>

                <!-- SUPPLY TIMELINE -->
                <VBox class="quadsWhiteCard sapUiSmallMarginBottom">
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiMediumMarginBottom">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://shipping-status" class="quadsSectionIcon blue sapUiSmallMarginEnd" />
                            <VBox>
                                <Title text="Supply Timeline" class="quadsSectionTitle" />
                                <Text text="Key milestones and current status of the disrupted supply." class="quadsSectionSub" />
                            </VBox>
                        </HBox>
                        <Button text="View Details" icon="sap-icon://action" type="Transparent" class="quadsBtnOutline" />
                    </HBox>

                    <!-- The Custom Timeline visualization -->
                    <HBox class="quadsCustomTimelineContainer" alignItems="Center" renderType="Bare">
                        
                        <!-- Node 1 -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <Text text="PO Created" class="quadsTlLabel" wrapping="false" />
                            <Text text="28 Aug" class="quadsTlDate" wrapping="false" />
                            <core:Icon src="sap-icon://sys-enter-2" class="quadsTlIcon done" />
                        </VBox>
                        <VBox class="quadsTlLine done" />
                        
                        <!-- Node 2 -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <Text text="Supplier Dispatch" class="quadsTlLabel" wrapping="false" />
                            <Text text="01 Sep" class="quadsTlDate" wrapping="false" />
                            <core:Icon src="sap-icon://sys-enter-2" class="quadsTlIcon done" />
                        </VBox>
                        <VBox class="quadsTlLine done" />

                        <!-- Node 3 -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <Text text="In Transit" class="quadsTlLabel bold" wrapping="false" />
                            <Text text="03 Sep" class="quadsTlDate bold" wrapping="false" />
                            <VBox class="quadsTlIcon currentBox" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://shipping-status" class="quadsTlIconCurrent" />
                            </VBox>
                        </VBox>
                        <VBox class="quadsTlLine current" />

                        <!-- Node 4 (Disruption) -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <VBox class="quadsTlLabelBoxCritical" alignItems="Center" renderType="Bare">
                                <Text text="Disruption" class="quadsTlLabelBoxText" wrapping="false" />
                            </VBox>
                            <Text text="06 Sep" class="quadsTlDate bold" wrapping="false" />
                            <VBox class="quadsTlIcon criticalBox" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://alert" class="quadsTlIconCritical" />
                            </VBox>
                        </VBox>
                        
                        <!-- Delay line -->
                        <VBox class="quadsTlLine delayLineBox" alignItems="Center" justifyContent="Center" renderType="Bare">
                            <VBox class="delayDashedLine" renderType="Bare" />
                            <Text text="5 days delay" class="delayLineText" wrapping="false" />
                        </VBox>

                        <!-- Node 5 (Revised Delivery) -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <Text text="Revised Delivery" class="quadsTlLabel critical" wrapping="false" />
                            <Text text="{impact>/inventory/stockoutDate_formatted}" class="quadsTlDate critical" wrapping="false" />
                            <VBox class="quadsTlIcon futureBoxCritical" />
                        </VBox>
                        <VBox class="quadsTlLine future" />

                        <!-- Node 6 (Expected Delivery) -->
                        <VBox class="quadsTimelineNode" alignItems="Center" renderType="Bare">
                            <Text text="Expected Delivery" class="quadsTlLabel future" wrapping="false" />
                            <Text text="{impact>/case/expected_delivery_date}" class="quadsTlDate future" wrapping="false" />
                            <VBox class="quadsTlIcon futureBox" />
                        </VBox>

                    </HBox>
                </VBox>


                <!-- Running Indicator Banner (Real Backend Telemetry Progress) -->
                <VBox
                    visible="{= ${impact>/analysisState} === 'RUNNING' }"
                    class="sapFioriMessageStrip info sapUiSmallMarginBottom"
                    style="display: block; padding: 16px;">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center" class="sapMBusyIndicatorBox">
                            <BusyIndicator size="1.2rem" class="sapUiSmallMarginEnd" />
                            <VBox>
                                <Text text="Agent 1: Impact analysis in progress..." class="bold textPrimary" />
                                <Text text="Processing cross-functional disruption telemetry from backend..." class="textSmall textDark" />
                            </VBox>
                        </HBox>
                        <ObjectStatus text="● RUNNING" state="Information" class="bold" inverted="true" />
                    </HBox>
                    <VBox class="sapUiSmallMarginTop" items="{impact>/steps}" style="padding-left: 2.2rem;">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon
                                src="{= ${impact>status} === 'COMPLETED' ? 'sap-icon://accept' : (${impact>status} === 'RUNNING' ? 'sap-icon://record' : 'sap-icon://circle-task') }"
                                color="{= ${impact>status} === 'COMPLETED' ? '#107E3E' : (${impact>status} === 'RUNNING' ? '#0A6ED1' : '#6A6D70') }"
                                size="14px"
                                class="sapUiTinyMarginEnd" />
                            <Text
                                text="{impact>label}"
                                class="{= ${impact>status} === 'RUNNING' ? 'bold textPrimary' : (${impact>status} === 'COMPLETED' ? 'textDark' : 'textMuted') }" />
                        </HBox>
                    </VBox>
                </VBox>



                <!-- BOTTOM 2 CARDS (PLANT & FINANCIAL) -->
                <HBox class="quadsImpact2Grid sapUiSmallMarginBottom">
                    
                    <!-- Plant & Production Details -->
                    <VBox class="quadsWhiteCard">
                        <HBox alignItems="Center" class="sapUiMediumMarginBottom">
                            <core:Icon src="sap-icon://factory" class="quadsSectionIcon blue sapUiSmallMarginEnd" />
                            <Title text="Plant &amp; Production Details" class="quadsSectionTitle" />
                        </HBox>
                        <HBox class="quadsPlantGrid">
                            <VBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Plant" class="quadsDetailLabel" />
                                    <Text text="{impact>/production/plantId} ({impact>/production/plantName})" class="quadsDetailValue" />
                                </HBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Production Rate (Normal)" class="quadsDetailLabel" />
                                    <Text text="100 cars/day" class="quadsDetailValue" />
                                </HBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Production Orders Affected" class="quadsDetailLabel" />
                                    <VBox>
                                        <Text text="{impact>/production/affectedOrders} orders (PO-1001, PO-1002, PO-1003)" class="quadsDetailValue" />
                                    </VBox>
                                </HBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Material Requirement" class="quadsDetailLabel" />
                                    <Text text="{impact>/production/dailyRequirement} units" class="quadsDetailValue" />
                                </HBox>
                            </VBox>
                            <VBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Current Available Capacity" class="quadsDetailLabel" />
                                    <Text text="Normal" class="quadsDetailValue" />
                                </HBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Production Interruption Risk" class="quadsDetailLabel" />
                                    <ObjectStatus text="High" class="quadsBadgeCriticalBox" />
                                </HBox>
                                <HBox justifyContent="SpaceBetween" class="quadsDetailRow">
                                    <Text text="Production Start/Stop Date" class="quadsDetailLabel" />
                                    <Text text="{impact>/inventory/stockoutDate_formatted} (Delayed)" class="quadsDetailValue" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Financial Exposure -->
                    <VBox class="quadsWhiteCard">
                        <HBox alignItems="Center" class="sapUiMediumMarginBottom">
                            <core:Icon src="sap-icon://money-bills" class="quadsSectionIcon blue sapUiSmallMarginEnd" />
                            <Title text="Financial Exposure" class="quadsSectionTitle" />
                        </HBox>
                        
                        <HBox class="quadsFinancial3Grid sapUiMediumMarginBottom">
                            <VBox class="quadsFinBox">
                                <Text text="Production Loss" class="quadsFinLabel" />
                                <Text text="{impact>/financial/estimated_display}" class="quadsFinValue" />
                                <Text text="(Based on {impact>/case/expected_delay_days} days)" class="quadsFinSub" />
                            </VBox>
                            <VBox class="quadsFinDivider" />
                            <VBox class="quadsFinBox">
                                <Text text="Revenue at Risk" class="quadsFinLabel" />
                                <Text text="{impact>/financial/potential_display}" class="quadsFinValue" />
                                <Text text="(Delayed orders)" class="quadsFinSub" />
                            </VBox>
                            <VBox class="quadsFinDivider" />
                            <VBox class="quadsFinBox">
                                <Text text="Customer Penalty (Est.)" class="quadsFinLabel" />
                                <Text text="{impact>/financial/confirmed_display}" class="quadsFinValue" />
                                <Text text="(Based on 3% of order value)" class="quadsFinSub" />
                            </VBox>
                        </HBox>
                        
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsFinTotalBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://trend-up" class="sapUiSmallMarginEnd quadsFinTotalIcon" />
                                <Text text="Total Financial Exposure" class="quadsFinTotalLabel" />
                            </HBox>
                            <HBox alignItems="Center">
                                <Text text="{impact>/financial/totalExposure_formatted}" class="quadsFinTotalValue sapUiSmallMarginEnd" />
                                <core:Icon src="sap-icon://slim-arrow-right" class="quadsFinTotalArrow" />
                            </HBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- END TO END PROPAGATION -->
                <VBox class="quadsWhiteCard sapUiMediumMarginBottom">
                    <HBox alignItems="Center" class="sapUiMediumMarginBottom">
                        <core:Icon src="sap-icon://chain-link" class="quadsSectionIcon blue sapUiSmallMarginEnd" />
                        <VBox>
                            <Title text="End-to-End Impact Propagation" class="quadsSectionTitle" />
                            <Text text="How the disruption propagates across the supply chain." class="quadsSectionSub" />
                        </VBox>
                    </HBox>
                    
                    <HBox class="quadsPropagationContainer" alignItems="Center">
                        <HBox class="quadsPropNode" alignItems="Center">
                            <VBox class="quadsPropIconBox"><core:Icon src="sap-icon://shipping-status" /></VBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Supplier Delay" class="quadsPropLabel" />
                                <Text text="+{impact>/case/expected_delay_days} days" class="quadsPropValue" />
                            </VBox>
                        </HBox>
                        
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsPropArrow" />
                        
                        <HBox class="quadsPropNode" alignItems="Center">
                            <VBox class="quadsPropIconBox"><core:Icon src="sap-icon://product" /></VBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Reduced Inbound Supply" class="quadsPropLabel" />
                                <Text text="{impact>/inventory/supplyGap_formatted}" class="quadsPropValue" />
                            </VBox>
                        </HBox>
                        
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsPropArrow" />
                        
                        <HBox class="quadsPropNode" alignItems="Center">
                            <VBox class="quadsPropIconBox"><core:Icon src="sap-icon://factory" /></VBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Production Impact" class="quadsPropLabel" />
                                <Text text="3 orders delayed" class="quadsPropValue" />
                            </VBox>
                        </HBox>
                        
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsPropArrow" />
                        
                        <HBox class="quadsPropNode" alignItems="Center">
                            <VBox class="quadsPropIconBox"><core:Icon src="sap-icon://money-bills" /></VBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Revenue at Risk" class="quadsPropLabel" />
                                <Text text="{impact>/financial/potential_display}" class="quadsPropValue" />
                            </VBox>
                        </HBox>
                        
                        <core:Icon src="sap-icon://slim-arrow-right" class="quadsPropArrow" />
                        
                        <HBox class="quadsPropNode" alignItems="Center">
                            <VBox class="quadsPropIconBox"><core:Icon src="sap-icon://document-text" /></VBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <Text text="Penalty Risk" class="quadsPropLabel" />
                                <Text text="{impact>/financial/confirmed_display}" class="quadsPropValue" />
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- PROCEED TO RECOVERY -->
                <HBox justifyContent="End" class="sapUiMediumMarginBottom">
                    <Button id="btnProceedPriorityBottom" text="PROCEED TO RECOVERY PRIORITY" icon="sap-icon://navigation-right-arrow" type="Emphasized" press=".onProceedPriority" class="quadsProceedBtn" />
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
