<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Dialog
        id="inspectPlanDialog"
        contentWidth="1100px"
        contentHeight="80vh"
        resizable="true"
        draggable="true"
        class="quadsPlanDetailDialog">

        <!-- Custom Header -->
        <customHeader>
            <Bar class="quadsPlanDetailHeader">
                <contentLeft>
                    <VBox>
                        <Title text="PLAN DETAILS" level="H2" class="quadsPlanDetailTitle" />
                        <Text text="Detailed execution plan — Cost, Risk, Constraint &amp; Feasibility Evaluation" class="quadsPlanDetailSubtitle" />
                    </VBox>
                </contentLeft>
                <contentRight>
                    <HBox alignItems="Center">
                        <VBox class="quadsPlanDetailHeaderMeta sapUiSmallMarginEnd">
                            <Text text="PLAN ID" class="quadsPlanDetailMetaLabel" />
                            <Text text="{inspect>/plan_id} ({inspect>/version})" class="quadsPlanDetailMetaValue" />
                        </VBox>
                        <VBox class="quadsPlanDetailHeaderMeta sapUiSmallMarginEnd">
                            <Text text="STRATEGY" class="quadsPlanDetailMetaLabel" />
                            <Text text="{path: 'inspect>/strategy', formatter: '.formatStrategyLabel'}" class="quadsPlanDetailMetaValueBlue" />
                        </VBox>
                        <HBox alignItems="Center">
                            <HBox class="{= ${inspect>/is_feasible} ? 'quadsPlanBadge quadsPlanBadgeFeasible' : 'quadsPlanBadge quadsPlanBadgeInfeasible'}" >
                                <Text text="{= ${inspect>/is_feasible} ? 'FEASIBLE' : 'INFEASIBLE'}" class="quadsPlanBadgeText" />
                            </HBox>
                            <HBox class="{= ${inspect>/operational_risk} === 'LOW' ? 'quadsPlanBadge quadsPlanBadgeLowRisk sapUiTinyMarginBegin' : 'quadsPlanBadge quadsPlanBadgeMedRisk sapUiTinyMarginBegin'}">
                                <Text text="{= ${inspect>/operational_risk} === 'LOW' ? 'LOW RISK' : (${inspect>/operational_risk} === 'MEDIUM' ? 'MEDIUM RISK' : 'HIGH RISK')}" class="quadsPlanBadgeText" />
                            </HBox>
                        </HBox>
                        <Button icon="sap-icon://decline" type="Transparent" press=".onCloseInspectDialog" class="sapUiSmallMarginBegin" />
                    </HBox>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <ScrollContainer vertical="true" horizontal="false" height="100%" width="100%">
            <VBox class="quadsPlanDetailBody">

                <!-- ═══ 1. RECOVERY OVERVIEW ═══ -->
                <VBox class="quadsPlanSection">
                    <Text text="1. RECOVERY OVERVIEW" class="quadsPlanSectionTitle" />
                    <HBox class="quadsPlanKpiRow" wrap="NoWrap">
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://shipping-status" class="quadsPlanKpiIcon" />
                                <Text text="RECOVERY QUANTITY" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{inspect>/recovered_quantity}" class="quadsPlanKpiValue" />
                        </VBox>
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://time-overtime" class="quadsPlanKpiIcon" />
                                <Text text="RECOVERY TIME" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{inspect>/recovery_days} days" class="quadsPlanKpiValue" />
                        </VBox>
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://calendar" class="quadsPlanKpiIcon" />
                                <Text text="ETA" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{inspect>/transport_days} days" class="quadsPlanKpiValue" />
                        </VBox>
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://money-bills" class="quadsPlanKpiIcon" />
                                <Text text="TOTAL COST" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanKpiValue" />
                        </VBox>
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon>/money-bills" class="quadsPlanKpiIcon" />
                                <Text text="FULFILLMENT" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{inspect>/fulfillment_pct}%" class="quadsPlanKpiValue" />
                        </VBox>
                        <VBox class="quadsPlanKpiBox">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://customer" class="quadsPlanKpiIcon" />
                                <Text text="CUSTOMER DELAY" class="quadsPlanKpiLabel" />
                            </HBox>
                            <Text text="{inspect>/customer_delay_days} days" class="quadsPlanKpiValue" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ═══ 2. SOURCE → DESTINATION ═══ -->
                <VBox class="quadsPlanSection">
                    <Text text="2. SOURCE → DESTINATION" class="quadsPlanSectionTitle" />
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanRouteRow">
                        <VBox alignItems="Center" class="quadsPlanRouteBox">
                            <core:Icon src="sap-icon://factory" class="quadsPlanRouteIcon" />
                            <Text text="SOURCE" class="quadsPlanRouteLabel" />
                            <Text text="{inspect>/source_name}" class="quadsPlanRouteName" />
                            <Text text="{inspect>/source_location}" class="quadsPlanRouteLocation" />
                        </VBox>
                        <HBox alignItems="Center" class="quadsPlanRouteArrow">
                            <core:Icon src="sap-icon://arrow-right" class="quadsPlanRouteArrowIcon" />
                        </HBox>
                        <VBox alignItems="Center" class="quadsPlanRouteBox">
                            <core:Icon src="sap-icon://map" class="quadsPlanRouteIcon" />
                            <Text text="DESTINATION" class="quadsPlanRouteLabel" />
                            <Text text="{inspect>/target_plant_name}" class="quadsPlanRouteName" />
                            <Text text="{inspect>/transport_name}" class="quadsPlanRouteLocation" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ═══ 3+4+5+6 — 3-col cards row ═══ -->
                <HBox class="quadsPlanCardsRow" wrap="Wrap">

                    <!-- 3. TRANSPORTATION DETAILS -->
                    <VBox class="quadsPlanCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanCardHeader">
                            <Text text="3. TRANSPORTATION DETAILS" class="quadsPlanCardTitle" />
                            <HBox class="quadsPlanPassBadge">
                                <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                <Text text="{= ${inspect>/is_feasible} ? 'PASSED' : 'FAILED'}" class="quadsPlanPassText" />
                            </HBox>
                        </HBox>
                        <HBox class="quadsPlanCardColsRow">
                            <VBox class="quadsPlanCardCol">
                                <Text text="SUPPLY" class="quadsPlanColHeader" />
                                <Text text="Available" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                                <Text text="Required" class="quadsPlanColLabel" />
                                <Text text="{inspect>/target_quantity}" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="TIMELINE" class="quadsPlanColHeader" />
                                <Text text="ETA" class="quadsPlanColLabel" />
                                <Text text="{inspect>/transport_days} days" class="quadsPlanColValue" />
                                <Text text="Recovery" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovery_days} days" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="COST" class="quadsPlanColHeader" />
                                <Text text="₹" class="quadsPlanColLabel" />
                                <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanColValue quadsPlanColValueCost" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="CONSTRAINT" class="quadsPlanColHeader" />
                                <Text text="{inspect>/transport_name}" class="quadsPlanColValue" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- 4. COST BREAKDOWN -->
                    <VBox class="quadsPlanCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanCardHeader">
                            <Text text="4. COST BREAKDOWN" class="quadsPlanCardTitle" />
                            <HBox class="quadsPlanPassBadge">
                                <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                <Text text="PASSED" class="quadsPlanPassText" />
                            </HBox>
                        </HBox>
                        <layout:Grid defaultSpan="XL6 L6 M6 S6" hSpacing="0.5" vSpacing="0">
                            <VBox>
                                <Text text="Quantity" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                            </VBox>
                            <VBox>
                                <Text text="ETA" class="quadsPlanColLabel" />
                                <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanColValue quadsPlanColValueCost" />
                            </VBox>
                            <VBox>
                                <Text text="Recovery Time" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovery_days} days" class="quadsPlanColValue" />
                            </VBox>
                            <VBox>
                                <Text text="Customer Delay" class="quadsPlanColLabel" />
                                <Text text="{inspect>/customer_delay_days} days" class="quadsPlanColValue" />
                            </VBox>
                            <VBox>
                                <Text text="Total Cost" class="quadsPlanColLabel" />
                                <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanColValue quadsPlanColValueCost" />
                            </VBox>
                            <VBox>
                                <Text text="Total Cost" class="quadsPlanColLabel" />
                                <Text text="{path: 'inspect>/transport_cost', formatter: '.formatCostL'}" class="quadsPlanColValue" />
                            </VBox>
                        </layout:Grid>
                    </VBox>

                </HBox>

                <!-- ═══ IMPACT + CONSTRAINT STATUS row ═══ -->
                <HBox class="quadsPlanCardsRow" wrap="Wrap">

                    <!-- 5. IMPACT -->
                    <VBox class="quadsPlanCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanCardHeader">
                            <Text text="5. IMPACT" class="quadsPlanCardTitle" />
                            <HBox class="quadsPlanPassBadge">
                                <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                <Text text="PASSED" class="quadsPlanPassText" />
                            </HBox>
                        </HBox>
                        <HBox class="quadsPlanCardColsRow">
                            <VBox class="quadsPlanCardCol">
                                <Text text="SUPPLY" class="quadsPlanColHeader" />
                                <Text text="Available" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                                <Text text="Required" class="quadsPlanColLabel" />
                                <Text text="{inspect>/target_quantity}" class="quadsPlanColValue" />
                                <Text text="Fulfilled" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="TIMELINE" class="quadsPlanColHeader" />
                                <Text text="ETA" class="quadsPlanColLabel" />
                                <Text text="{inspect>/transport_days} days" class="quadsPlanColValue" />
                                <Text text="Recovery" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovery_days} days" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="COST" class="quadsPlanColHeader" />
                                <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanColValue quadsPlanColValueCost" />
                                <Text text="{= '-' + Math.round(10) + '% vs normal'}" class="quadsPlanColSmall" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="CONSTRAINT" class="quadsPlanColHeader" />
                                <Text text="Internal transport capacity" class="quadsPlanColValue" />
                            </VBox>
                        </HBox>
                        <!-- Impact metrics row -->
                        <HBox class="quadsPlanImpactMetrics sapUiTinyMarginTop">
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text="IMPACT" class="quadsPlanColLabel" />
                                <Text text="Production" class="quadsPlanColSmall" />
                                <Text text="{= ${inspect>/production_impact_remaining} || '-1 day'}" class="quadsPlanImpactVal" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Customer" class="quadsPlanColSmall" />
                                <Text text="{= ${inspect>/customer_delay_days} > 0 ? '+' + ${inspect>/customer_delay_days} + ' days' : '0 days'}" class="quadsPlanImpactValWarn" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Fulfilment" class="quadsPlanColSmall" />
                                <Text text="{inspect>/fulfillment_pct}%" class="quadsPlanImpactVal" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Severity" class="quadsPlanColSmall" />
                                <ObjectStatus text="{inspect>/operational_risk}" state="{path: 'inspect>/operational_risk', formatter: '.formatRiskState'}" class="quadsPlanSeverityStatus" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- 6. CONSTRAINT STATUS -->
                    <VBox class="quadsPlanCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanCardHeader">
                            <Text text="6. CONSTRAINT STATUS" class="quadsPlanCardTitle" />
                            <HBox class="{= ${inspect>/is_feasible} ? 'quadsPlanPassBadge' : 'quadsPlanFailBadge'}">
                                <core:Icon src="{= ${inspect>/is_feasible} ? 'sap-icon://sys-enter-2' : 'sap-icon://error'}" class="{= ${inspect>/is_feasible} ? 'quadsPlanPassIcon' : 'quadsPlanFailIcon'}" />
                                <Text text="{= ${inspect>/is_feasible} ? 'PASSED' : 'FAILED'}" class="{= ${inspect>/is_feasible} ? 'quadsPlanPassText' : 'quadsPlanFailText'}" />
                            </HBox>
                        </HBox>
                        <HBox class="quadsPlanCardColsRow">
                            <VBox class="quadsPlanCardCol">
                                <Text text="SUPPLY" class="quadsPlanColHeader" />
                                <Text text="Available" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                                <Text text="Required" class="quadsPlanColLabel" />
                                <Text text="{inspect>/target_quantity}" class="quadsPlanColValue" />
                                <Text text="Fulfilled" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovered_quantity}" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="TIMELINE" class="quadsPlanColHeader" />
                                <Text text="ETA" class="quadsPlanColLabel" />
                                <Text text="{inspect>/transport_days} days" class="quadsPlanColValue" />
                                <Text text="Recovery" class="quadsPlanColLabel" />
                                <Text text="{inspect>/recovery_days} days" class="quadsPlanColValue" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="COST" class="quadsPlanColHeader" />
                                <Text text="{path: 'inspect>/total_cost', formatter: '.formatCostL'}" class="quadsPlanColValue quadsPlanColValueCost" />
                                <Text text="-12% vs normal" class="quadsPlanColSmall" />
                            </VBox>
                            <VBox class="quadsPlanCardCol">
                                <Text text="CONSTRAINT" class="quadsPlanColHeader" />
                                <Text text="Rail transit Delay (weather)" class="quadsPlanColValue" />
                            </VBox>
                        </HBox>
                        <!-- Impact row -->
                        <HBox class="quadsPlanImpactMetrics sapUiTinyMarginTop">
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text="IMPACT" class="quadsPlanColLabel" />
                                <Text text="Production" class="quadsPlanColSmall" />
                                <Text text="-2 days" class="quadsPlanImpactVal" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Customer" class="quadsPlanColSmall" />
                                <Text text="+5 days" class="quadsPlanImpactValWarn" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Fulfilment" class="quadsPlanColSmall" />
                                <Text text="88%" class="quadsPlanImpactVal" />
                            </VBox>
                            <VBox class="quadsPlanImpactMetricBox">
                                <Text text=" " class="quadsPlanColLabel" />
                                <Text text="Severity" class="quadsPlanColSmall" />
                                <ObjectStatus text="{inspect>/operational_risk}" state="{path: 'inspect>/operational_risk', formatter: '.formatRiskState'}" class="quadsPlanSeverityStatus" />
                            </VBox>
                        </HBox>
                        <HBox justifyContent="End" class="sapUiTinyMarginTop">
                            <Link text="View Plan Details →" press=".onCloseInspectDialog" class="quadsPlanDetailLink" />
                        </HBox>
                    </VBox>

                </HBox>

                <!-- ═══ 7. GOVERNING RULES ═══ -->
                <VBox class="quadsPlanSection">
                    <Text text="7. GOVERNING RULES" class="quadsPlanSectionTitle" />
                    <Text text="Governing rules in governing rules and transordering rules" class="quadsPlanSectionSubtitle" />

                    <HBox class="quadsPlanRulesRow" wrap="Wrap">
                        <!-- Rule 1 -->
                        <VBox class="quadsPlanRuleCard">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanRuleHeader">
                                <Text text="SOURCE SAFETY STOCK" class="quadsPlanRuleTitle" />
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                <core:Icon src="sap-icon://accept" class="quadsPlanRuleCheckIcon" />
                                <Text text="Source safety stock ≥100" class="quadsPlanRuleText" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="End">
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Rule 2 -->
                        <VBox class="quadsPlanRuleCard">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanRuleHeader">
                                <Text text="STOCKOUT ARRIVAL LIMIT" class="quadsPlanRuleTitle" />
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                <core:Icon src="sap-icon://accept" class="quadsPlanRuleCheckIcon" />
                                <Text text="Stockout arrival limit" class="quadsPlanRuleText" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="End">
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Rule 3 -->
                        <VBox class="quadsPlanRuleCard">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="quadsPlanRuleHeader">
                                <Text text="BUDGET &amp; LEAD-TIME CAPS" class="quadsPlanRuleTitle" />
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                <core:Icon src="sap-icon://accept" class="quadsPlanRuleCheckIcon" />
                                <Text text="Insufficient lead-time capacity" class="quadsPlanRuleText" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="End">
                                <HBox class="quadsPlanPassBadge">
                                    <core:Icon src="sap-icon://sys-enter-2" class="quadsPlanPassIcon" />
                                    <Text text="PASSED" class="quadsPlanPassText" />
                                </HBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
            </ScrollContainer>
        </content>

        <beginButton>
            <Button
                text="Select This Plan"
                type="Accept"
                icon="sap-icon://accept"
                press=".onSelectPlanFromDialog" />
        </beginButton>

        <endButton>
            <Button text="Close" press=".onCloseInspectDialog" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>
