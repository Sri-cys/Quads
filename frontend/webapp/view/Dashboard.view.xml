<mvc:View
    controllerName="com.quads.supplychain.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">




                <!-- 3. High-Level Operational Metrics Grid (6 Metrics) -->
                <layout:Grid
                    defaultSpan="XL2 L2 M4 S6"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapKpiGrid sapUiSmallMarginBottom">
                    
                    <!-- Metric 1: Total Active Disruptions -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ALL_ACTIVE" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTIVE DISRUPTIONS" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://alert" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/active}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="Open supply incidents" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="ALL_ACTIVE" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 2: Active Recoveries -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ACTIVE_RECOVERIES" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTIVE RECOVERIES" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://action" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/activeRecoveries}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="In planning &amp; execution" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="ACTIVE_RECOVERIES" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 3: At Risk -->
                    <VBox class="sapKpiCard warningBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="AT_RISK" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="AT RISK" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://warning2" class="sapKpiIcon warning" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/atRisk}" class="sapKpiNumber textWarning" />
                        </HBox>
                        <Text text="Buffer breach warning" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textWarning">
                            <customData><core:CustomData key="category" value="AT_RISK" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 4: Action Required -->
                    <VBox class="sapKpiCard criticalBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ACTION_REQUIRED" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTION REQUIRED" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://error" class="sapKpiIcon critical" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/actionRequired}" class="sapKpiNumber textCritical" />
                        </HBox>
                        <Text text="Manager decision needed" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textCritical">
                            <customData><core:CustomData key="category" value="ACTION_REQUIRED" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 5: Cases in Execution -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="IN_EXECUTION" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="IN EXECUTION" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://shipping-status" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/inExecution}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="Approved plans active" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="IN_EXECUTION" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 6: Cases Resolved -->
                    <VBox class="sapKpiCard successBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="RESOLVED" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="CASES RESOLVED" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://accept" class="sapKpiIcon success" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/resolved}" class="sapKpiNumber textSuccess" />
                        </HBox>
                        <Text text="Successfully archived" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textSuccess">
                            <customData><core:CustomData key="category" value="RESOLVED" /></customData>
                        </Link>
                    </VBox>
                </layout:Grid>


                <!-- 5. Disruption Severity & Prioritized Cases (2 Columns) -->
                <VBox class="quadsDashboardTwoColRow sapUiSmallMarginBottom">

                    <!-- Col 1: Operational Severity Breakdown -->
                    <VBox class="sapCard quadsStretchCard">
                        <!-- Header -->
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://pie-chart" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                                <Title text="Disruption Severity" level="H3" class="bold textDark" />
                            </HBox>
                            <ObjectStatus text="{dashboard>/stats/totalCases} Total" state="None" class="bold" />
                        </HBox>

                        <!-- Donut and Legend -->
                        <HBox alignItems="Center" justifyContent="Center" class="quadsDonutContainer sapUiMediumMarginTopBottom">
                            <!-- Donut Chart (Dynamic Proportional CSS via Formatter) -->
                            <core:HTML content="{
                                path: 'dashboard>/stats',
                                formatter: '.formatDonutChart'
                            }" />
                            
                            <!-- Legend -->
                            <VBox>
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://error" size="16px" class="sapUiTinyMarginEnd textCritical" />
                                        <Text text="Critical" class="textDark" />
                                    </HBox>
                                    <Text text="{dashboard>/stats/critical}" class="bold textCritical sapKpiNumberSmall sapUiLargeMarginLeft" />
                                </HBox>
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://alert" size="16px" class="sapUiTinyMarginEnd textWarning" />
                                        <Text text="High Risk" class="textDark" />
                                    </HBox>
                                    <Text text="{dashboard>/stats/high}" class="bold textWarning sapKpiNumberSmall sapUiLargeMarginLeft" />
                                </HBox>
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://information" size="16px" class="sapUiTinyMarginEnd quadsTextMedium" />
                                        <Text text="Medium Risk" class="textDark" />
                                    </HBox>
                                    <Text text="{dashboard>/stats/medium}" class="bold quadsTextMedium sapKpiNumberSmall sapUiLargeMarginLeft" />
                                </HBox>
                                <HBox alignItems="Center" justifyContent="SpaceBetween">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://sys-enter-2" size="16px" class="sapUiTinyMarginEnd textSuccess" />
                                        <Text text="Low Risk" class="textDark" />
                                    </HBox>
                                    <Text text="{dashboard>/stats/low}" class="bold textSuccess sapKpiNumberSmall sapUiLargeMarginLeft" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Footer -->
                        <Text text="Classified deterministically by warehouse buffer days of cover." class="textSmall textMuted sapUiSmallMarginTop" />
                    </VBox>

                    <!-- Col 2: Prioritized Cases -->
                    <VBox class="sapCard quadsStretchCard">
                        <!-- Header -->
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://list" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                                <Title text="Prioritized Cases" level="H3" class="bold textDark" />
                            </HBox>
                            <Link text="View All Cases &#x2192;" press=".onNavCases" class="bold textInfo" />
                        </HBox>

                        <Table
                            items="{dashboard>/topCases}"
                            noDataText="No actionable cases found"
                            showSeparators="Inner"
                            class="sapUiSizeCompact quadsDashboardTable">
                            <columns>
                                <Column><Text text="Case" class="bold textMuted" /></Column>
                                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="Severity / DoC" class="bold textMuted" /></Column>
                                <Column demandPopin="true" minScreenWidth="Tablet"><Text text="Status" class="bold textMuted" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" press=".onNavCases">
                                    <cells>
                                        <VBox class="sapUiTinyMarginTopBottom">
                                            <Text text="{dashboard>case_id}" class="bold textDark" />
                                            <Text text="{dashboard>disruption_name}" class="textSmall textMuted" />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginTopBottom">
                                            <ObjectStatus text="{dashboard>severity_text}" class="bold {dashboard>severity_css}" />
                                            <Text text="{dashboard>doc_display} DoC" class="textSmall textMuted" />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginTopBottom">
                                            <Text text="{dashboard>status_text}" class="bold {dashboard>status_css}" />
                                            <Text text="{dashboard>supplier_display}" class="textSmall textMuted" />
                                        </VBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
