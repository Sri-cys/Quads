<mvc:View
    controllerName="com.quads.supplychain.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">


                <!-- 2. System Workflow Overview (Informational Only) -->
                <VBox class="sapCard sapUiSmallMarginBottom">
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://process" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                            <Title text="Autonomous Disruption Recovery Lifecycle" level="H3" class="bold textDark" />
                        </HBox>
                        <Text text="Single Source of Truth: Backend State Engine" class="textSmall textMuted" />
                    </HBox>
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://alert" size="14px" class="sapUiTinyMarginEnd textWarning" />
                            <Text text="Disruption Ingestion" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://stethoscope" size="14px" class="sapUiTinyMarginEnd textInfo" />
                            <Text text="Agent 1 Impact" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://decision" size="14px" class="sapUiTinyMarginEnd textWarning" />
                            <Text text="Checkpoint 1 Priority" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://money-bills" size="14px" class="sapUiTinyMarginEnd textInfo" />
                            <Text text="Agent 2 Cost &amp; Constraints" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://compare" size="14px" class="sapUiTinyMarginEnd textSuccess" />
                            <Text text="Agent 3 Feasibility" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://accept" size="14px" class="sapUiTinyMarginEnd textCritical" />
                            <Text text="Manager Decision" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                            <core:Icon src="sap-icon://shipping-status" size="14px" class="sapUiTinyMarginEnd textInfo" />
                            <Text text="Execution &amp; Monitoring" class="bold textDark" />
                        </HBox>
                        <Text text="→" class="textMuted bold" />
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://flag" size="14px" class="sapUiTinyMarginEnd textSuccess" />
                            <Text text="Resolved Outcome" class="bold textDark" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- 3. High-Level Operational Metrics Grid (6 Metrics) -->
                <layout:Grid
                    defaultSpan="XL2 L2 M4 S6"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapKpiGrid sapUiSmallMarginBottom">
                    
                    <!-- Metric 1: Total Active Disruptions -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ALL_ACTIVE" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTIVE DISRUPTIONS" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://alert" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/active}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="Open supply incidents" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="ALL_ACTIVE" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 2: Active Recoveries -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ACTIVE_RECOVERIES" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTIVE RECOVERIES" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://action" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/activeRecoveries}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="In planning &amp; execution" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="ACTIVE_RECOVERIES" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 3: At Risk -->
                    <VBox class="sapKpiCard warningBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="AT_RISK" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="AT RISK" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://warning2" class="sapKpiIcon warning" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/atRisk}" class="sapKpiNumber textWarning" />
                        </HBox>
                        <Text text="Buffer breach warning" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textWarning">
                            <customData><core:CustomData key="category" value="AT_RISK" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 4: Action Required -->
                    <VBox class="sapKpiCard criticalBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="ACTION_REQUIRED" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="ACTION REQUIRED" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://error" class="sapKpiIcon critical" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/actionRequired}" class="sapKpiNumber textCritical" />
                        </HBox>
                        <Text text="Manager decision needed" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textCritical">
                            <customData><core:CustomData key="category" value="ACTION_REQUIRED" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 5: Cases in Execution -->
                    <VBox class="sapKpiCard infoBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="IN_EXECUTION" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="IN EXECUTION" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://shipping-status" class="sapKpiIcon info" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/inExecution}" class="sapKpiNumber textInfo" />
                        </HBox>
                        <Text text="Approved plans active" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textInfo">
                            <customData><core:CustomData key="category" value="IN_EXECUTION" /></customData>
                        </Link>
                    </VBox>

                    <!-- Metric 6: Cases Resolved -->
                    <VBox class="sapKpiCard successBorder" press=".onNavCasesToCategory">
                        <customData>
                            <core:CustomData key="category" value="RESOLVED" />
                        </customData>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapKpiTop">
                            <Text text="CASES RESOLVED" class="sapKpiTitle" />
                            <core:Icon src="sap-icon://accept" class="sapKpiIcon success" />
                        </HBox>
                        <HBox alignItems="Baseline" justifyContent="SpaceBetween" class="sapKpiMid">
                            <Text text="{dashboard>/stats/resolved}" class="sapKpiNumber textSuccess" />
                        </HBox>
                        <Text text="Successfully archived" class="sapKpiSub sapUiTinyMarginBottom" />
                        <Link text="VIEW CASES &#x2192;" press=".onNavCasesToCategory" class="bold textSuccess">
                            <customData><core:CustomData key="category" value="RESOLVED" /></customData>
                        </Link>
                    </VBox>
                </layout:Grid>


                <!-- 5. Recovery Overview & Multi-Agent Network Intelligence (3 Columns) -->
                <layout:Grid
                    defaultSpan="XL4 L4 M12 S12"
                    hSpacing="1"
                    vSpacing="1">

                    <!-- Col 1: Recovery Pipeline Status -->
                    <VBox class="sapCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://bbyd-active-sales" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                                <Title text="Active Recoveries Overview" level="H3" class="bold textDark" />
                            </HBox>
                            <ObjectStatus text="Live Pipeline" state="Information" class="bold" />
                        </HBox>
                        
                        <VBox class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text text="On Track Recoveries" class="textDark" />
                                <Text text="{dashboard>/stats/onTrack}" class="bold textSuccess" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text text="At Risk Deliveries" class="textDark" />
                                <Text text="{dashboard>/stats/atRisk}" class="bold textWarning" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text text="Action Required Interventions" class="textDark" />
                                <Text text="{dashboard>/stats/actionRequired}" class="bold textCritical" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                <Text text="Resolved Precedents" class="textDark" />
                                <Text text="{dashboard>/stats/resolved}" class="bold textDark" />
                            </HBox>
                        </VBox>

                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                            <Text text="Recovery Success Rate:" class="bold textMuted textSmall" />
                            <Text text="{dashboard>/stats/recoverySuccessRate}" class="bold textSuccess" />
                        </HBox>
                    </VBox>

                    <!-- Col 2: Operational Severity Breakdown -->
                    <VBox class="sapCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://pie-chart" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                                <Title text="Operational Severity Distribution" level="H3" class="bold textDark" />
                            </HBox>
                            <ObjectStatus text="{dashboard>/stats/totalCases} Total" state="None" class="bold" />
                        </HBox>

                        <VBox class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://error" size="14px" class="sapUiTinyMarginEnd textCritical" />
                                    <Text text="Critical (DoC ≤ 3 Days)" class="textDark" />
                                </HBox>
                                <Text text="{dashboard>/stats/critical}" class="bold textCritical" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://alert" size="14px" class="sapUiTinyMarginEnd textWarning" />
                                    <Text text="High Risk (DoC ≤ 5 Days)" class="textDark" />
                                </HBox>
                                <Text text="{dashboard>/stats/high}" class="bold textWarning" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://information" size="14px" class="sapUiTinyMarginEnd textInfo" />
                                    <Text text="Medium Risk" class="textDark" />
                                </HBox>
                                <Text text="{dashboard>/stats/medium}" class="bold textInfo" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://sys-enter-2" size="14px" class="sapUiTinyMarginEnd textSuccess" />
                                    <Text text="Low Risk" class="textDark" />
                                </HBox>
                                <Text text="{dashboard>/stats/low}" class="bold textSuccess" />
                            </HBox>
                        </VBox>

                        <Text text="Classified deterministically by warehouse buffer days of cover." class="textSmall textMuted sapUiSmallMarginTop" />
                    </VBox>

                    <!-- Col 3: 3-Agent Control Tower Engine Status -->
                    <VBox class="sapCard">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://connected" class="sapUiTinyMarginEnd" color="#0A6ED1" />
                                <Title text="3-Agent Multi-Agent Engine" level="H3" class="bold textDark" />
                            </HBox>
                            <ObjectStatus text="ONLINE" state="Success" class="bold" />
                        </HBox>

                        <VBox class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://clinical-triage-order" size="14px" class="sapUiTinyMarginEnd textInfo" />
                                    <Text text="Agent 1: Cross-Functional Impact" class="textDark" />
                                </HBox>
                                <ObjectStatus text="READY" state="Success" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://money-bills" size="14px" class="sapUiTinyMarginEnd textInfo" />
                                    <Text text="Agent 2: Cost &amp; Constraint Boundary" class="textDark" />
                                </HBox>
                                <ObjectStatus text="READY" state="Success" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://compare" size="14px" class="sapUiTinyMarginEnd textInfo" />
                                    <Text text="Agent 3: Feasibility &amp; Precedents" class="textDark" />
                                </HBox>
                                <ObjectStatus text="READY" state="Success" />
                            </HBox>
                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://user-edit" size="14px" class="sapUiTinyMarginEnd textWarning" />
                                    <Text text="Human Governance: Checkpoints" class="textDark" />
                                </HBox>
                                <ObjectStatus text="ENFORCED" state="Warning" />
                            </HBox>
                        </VBox>

                        <Text text="LangGraph state-machine orchestrates multi-agent transitions." class="textSmall textMuted sapUiSmallMarginTop" />
                    </VBox>
                </layout:Grid>

            </VBox>
        </content>
    </Page>
</mvc:View>
