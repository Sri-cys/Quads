<mvc:View
    controllerName="com.quads.supplychain.controller.ExecutionMonitoring"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="executionMonitoringPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">

        <content>
            <VBox class="sapCorporatePageBody">

                <!-- Consistent Case Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="EXECUTION &amp; MONITORING" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Real-time execution orchestration, carrier tracking, and telemetry monitoring." class="sapCorporatePageSubtitle" />
                    </VBox>
                    <Button
                        text="Refresh Telemetry"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefreshProgress" />
                </HBox>

                <!-- ═══ PENDING EXECUTION ═══ -->
                <VBox visible="{exec>/pending_execution}" class="sapUiMediumMarginTop">
                    <HBox alignItems="Center" class="sapStatusBanner sapStatusGate sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://decision" class="sapStatusBannerIcon gate" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="AWAITING EXECUTION TRIGGER" class="sapStatusBannerTitle" />
                            <Text text="Checkpoint 2 has been approved. Review the certified recovery plan below and initiate execution." class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <VBox class="sapContentCard">
                        <Text text="APPROVED RECOVERY PLAN" class="sapCardTitle" />
                        <layout:Grid defaultSpan="XL3 L3 M4 S6" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                            <VBox>
                                <Text text="Plan ID" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/plan_id} · {exec>/approved_plan/version}" class="bold textDark" style="font-size:14px" />
                            </VBox>
                            <VBox>
                                <Text text="Strategy" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/strategy}" class="bold" />
                            </VBox>
                            <VBox>
                                <Text text="Supplier / Source" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/source_name}" class="textDark" />
                            </VBox>
                            <VBox>
                                <Text text="Target Plant" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/destination_name}" class="bold" />
                            </VBox>
                            <VBox>
                                <Text text="Quantity" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/recovered_quantity} units" class="bold textDark" />
                            </VBox>
                            <VBox>
                                <Text text="Transport" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/transport_name}" class="textDark" />
                            </VBox>
                            <VBox>
                                <Text text="Expected Arrival" class="sapKpiLabel" />
                                <Text text="{exec>/approved_plan/expected_delivery_date}" class="bold textSuccess" />
                            </VBox>
                            <VBox>
                                <Text text="Estimated Cost" class="sapKpiLabel" />
                                <Text text="${= ${exec>/approved_plan/total_cost} ? ${exec>/approved_plan/total_cost}.toLocaleString() : '0' }" class="bold" />
                            </VBox>
                        </layout:Grid>

                        <HBox class="sapDecisionActionsRow sapUiMediumMarginTop" style="border-top: 1px solid #E5E5E5; padding-top: 16px;">
                            <Button text="Back to Recovery Planning" icon="sap-icon://nav-back" type="Transparent" press=".onReturnToPlanning" class="sapUiSmallMarginEnd" />
                            <Button text="Initiate Execution Action" icon="sap-icon://shipping-status" type="Emphasized" press=".onStartExecutionAction" class="sapBtnPrimary" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ═══ EXECUTION IN PROGRESS / ACTIVE MONITORING ═══ -->
                <VBox visible="{= !${exec>/pending_execution} }" class="sapUiMediumMarginTop">
                    
                    <!-- Banners -->
                    <HBox visible="{exec>/action_required}" alignItems="Center" class="sapStatusBanner sapStatusError sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="sapStatusBannerIcon error" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="⚠ ACTION REQUIRED — CRITICAL OPERATIONAL DEVIATION DETECTED" class="sapStatusBannerTitle" />
                            <Text text="Carrier telemetry indicates delivery schedule or quantity breach exceeding tolerance buffer." class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <HBox visible="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} &amp;&amp; !${exec>/action_required} &amp;&amp; ${exec>/monitoring_status} === 'ON_TRACK' }" alignItems="Center" class="sapStatusBanner sapStatusSuccess sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://sys-enter-2" class="sapStatusBannerIcon success" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="● ON TRACK — EXECUTION &amp; MONITORING ACTIVE" class="sapStatusBannerTitle" />
                            <Text text="Plan {exec>/baseline/plan_id} is executing within certified parameters. Telemetry normal." class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <HBox visible="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} &amp;&amp; !${exec>/action_required} &amp;&amp; ${exec>/monitoring_status} === 'AT_RISK' }" alignItems="Center" class="sapStatusBanner sapStatusWarning sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="sapStatusBannerIcon warning" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="▲ AT RISK — POTENTIAL DEVIATION DETECTED" class="sapStatusBannerTitle" />
                            <Text text="Delivery schedule has slipped. Monitoring buffer coverage to prevent stockout escalation." class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <HBox visible="{exec>/is_success}" alignItems="Center" class="sapStatusBanner sapStatusSuccess sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://sys-enter-2" class="sapStatusBannerIcon success" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="RECOVERY COMPLETED — CASE RESOLVED" class="sapStatusBannerTitle" />
                            <Text text="All material delivered within tolerance. Case closed and precedent archived." class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <HBox visible="{exec>/is_failed}" alignItems="Center" class="sapStatusBanner sapStatusError sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="sapStatusBannerIcon error" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="EXECUTION FAILED — RECOVERY PLANNING REQUIRED" class="sapStatusBannerTitle" />
                            <Text text="{exec>/failure_reason}" class="sapStatusBannerText" />
                        </VBox>
                    </HBox>

                    <!-- LIVE MONITORING / TELEMATICS SIMULATOR AS HORIZONTAL TIMELINE -->
                    <VBox class="sapContentCard sapUiSmallMarginBottom">
                        <Title text="LIVE MONITORING / TELEMATICS" level="H3" class="sapCardSectionTitle" />
                        <Text text="Active execution event timeline and manual telemetry simulation." class="sapCardSectionSub sapUiTinyMarginBottom" />
                        
                        <HBox alignItems="Center" class="sapTimelineNodesRow" style="gap: 12px; margin-top: 12px;">
                            <Button text="Supplier Confirmed" icon="sap-icon://supplier" press=".onSimulateSupplierConfirmed" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn" />
                            <core:Icon src="sap-icon://navigation-right-arrow" color="#D9D9D9" />
                            <Button text="Dispatched" icon="sap-icon://shipping-status" press=".onSimulateDispatched" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn" />
                            <core:Icon src="sap-icon://navigation-right-arrow" color="#D9D9D9" />
                            <Button text="In Transit" icon="sap-icon://map" press=".onSimulateInTransit" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn" />
                            <core:Icon src="sap-icon://navigation-right-arrow" color="#D9D9D9" />
                            <Button text="Delay +2d" icon="sap-icon://history" type="Attention" press=".onSimulateDelay" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn" />
                            <core:Icon src="sap-icon://navigation-right-arrow" color="#D9D9D9" />
                            <Button text="Delivered" icon="sap-icon://sys-enter-2" type="Emphasized" press=".onSimulateDelivered" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn sapBtnSuccess" />
                            <core:Icon src="sap-icon://navigation-right-arrow" color="#D9D9D9" />
                            <Button text="Failure" icon="sap-icon://alert" type="Reject" press=".onSimulateFailure" enabled="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="sapTimelineEventBtn" />
                        </HBox>
                    </VBox>

                    <!-- ACTION REQUIRED CARD -->
                    <VBox visible="{exec>/action_required}" class="sapContentCard sapUiSmallMarginBottom" style="border: 2px solid #E52929; background: #FFFBFB;">
                        <HBox alignItems="Center" class="sapOverviewHeader">
                            <core:Icon src="sap-icon://alert" class="sapStatusBannerIcon error sapUiTinyMarginEnd" />
                            <Title text="ACTION REQUIRED — OPERATIONAL INTERVENTION REQUIRED" level="H3" class="bold textCritical" />
                        </HBox>

                        <layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                            <VBox>
                                <Text text="PROBLEM" class="sapKpiLabel" />
                                <Text text="{= ${exec>/is_failed} ? ${exec>/failure_reason} : 'ETA slipped +' + ${exec>/deviation/delay_days} + ' days; buffer tolerance breached' }" class="bold textCritical" />
                            </VBox>
                            <VBox>
                                <Text text="IMPACT" class="sapKpiLabel" />
                                <Text text="{exec>/customer_impact}" class="bold textDark" />
                            </VBox>
                            <VBox>
                                <Text text="AFFECTED PLAN" class="sapKpiLabel" />
                                <Text text="{exec>/baseline/plan_id} ({exec>/baseline/strategy})" class="bold" />
                            </VBox>
                            <VBox>
                                <Text text="RECOMMENDED ACTION" class="sapKpiLabel" />
                                <Text text="Replan recovery or switch carrier route" class="bold textPrimary" />
                            </VBox>
                        </layout:Grid>

                        <HBox justifyContent="End" class="sapUiSmallMarginTop">
                            <Button text="Take Action (Acknowledge Alert)" icon="sap-icon://accept" type="Transparent" press=".onTakeActionAlert" class="sapUiSmallMarginEnd" />
                            <Button text="Replan Recovery Plan" icon="sap-icon://journey-change" type="Emphasized" press=".onReplanRecovery" class="sapBtnPrimary" />
                        </HBox>
                    </VBox>

                    <!-- COMPACT INFO GRID (Baseline, Telemetry, Variance) -->
                    <VBox class="quadsPlanGrid sapUiSmallMarginBottom" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
                        
                        <!-- Left Column: Baseline & Current Telemetry -->
                        <VBox class="sapContentCard" style="height: 100%;">
                            <Title text="Certified Baseline &amp; Current Status" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                            <layout:Grid defaultSpan="XL6 L6 M6 S12" hSpacing="1" vSpacing="1">
                                <VBox class="sapMetricRow">
                                    <Text text="APPROVED PLAN" class="sapMetricLabel" />
                                    <Text text="{exec>/baseline/plan_id}" class="bold textPrimary" />
                                </VBox>
                                <VBox class="sapMetricRow">
                                    <Text text="STRATEGY" class="sapMetricLabel" />
                                    <Text text="{exec>/baseline/strategy}" class="bold textDark" />
                                </VBox>
                                <VBox class="sapMetricRow">
                                    <Text text="SOURCE" class="sapMetricLabel" />
                                    <Text text="{exec>/baseline/source_name}" class="textDark" />
                                </VBox>
                                <VBox class="sapMetricRow">
                                    <Text text="CARRIER" class="sapMetricLabel" />
                                    <Text text="{exec>/action/carrier_name}" class="textDark" />
                                </VBox>
                                <VBox class="sapMetricRow">
                                    <Text text="SHIPMENT STATUS" class="sapMetricLabel" />
                                    <ObjectStatus text="{exec>/shipment_status}" state="{= ${exec>/shipment_status} === 'DELAYED' ? 'Warning' : (${exec>/shipment_status} === 'FAILED' ? 'Error' : 'Information') }" class="bold" />
                                </VBox>
                                <VBox class="sapMetricRow">
                                    <Text text="CURRENT ETA" class="sapMetricLabel" />
                                    <Text text="{exec>/current_estimated_arrival}" class="bold textDark" />
                                </VBox>
                            </layout:Grid>
                        </VBox>

                        <!-- Right Column: Planned vs Actual & Impact -->
                        <VBox class="sapContentCard" style="height: 100%;">
                            <Title text="Planned vs Actual Tracking" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                            
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <VBox>
                                    <Text text="Quantity" class="sapMetricLabel" />
                                    <Text text="{exec>/baseline/planned_quantity} Units Planned" class="textMuted" />
                                </VBox>
                                <VBox alignItems="End">
                                    <Text text="{exec>/current_confirmed_quantity} Units Actual" class="bold" />
                                    <ObjectStatus text="{= ${exec>/current_confirmed_quantity} >= ${exec>/baseline/planned_quantity} ? 'Fulfilled' : 'Pending' }" state="{= ${exec>/current_confirmed_quantity} >= ${exec>/baseline/planned_quantity} ? 'Success' : 'Warning' }" />
                                </VBox>
                            </HBox>
                            
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <VBox>
                                    <Text text="Arrival / ETA" class="sapMetricLabel" />
                                    <Text text="{exec>/baseline/planned_arrival_date} Planned" class="textMuted" />
                                </VBox>
                                <VBox alignItems="End">
                                    <Text text="{exec>/current_estimated_arrival} Actual" class="bold" />
                                    <ObjectStatus text="{= ${exec>/deviation/delay_days} === 0 ? 'On Schedule' : ('+' + ${exec>/deviation/delay_days} + 'd delay') }" state="{= ${exec>/deviation/delay_days} > 0 ? 'Warning' : 'Success' }" />
                                </VBox>
                            </HBox>

                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <VBox>
                                    <Text text="Recovery Cost" class="sapMetricLabel" />
                                    <Text text="${= ${exec>/baseline/planned_total_cost} ? ${exec>/baseline/planned_total_cost}.toLocaleString() : '0' } Planned" class="textMuted" />
                                </VBox>
                                <VBox alignItems="End">
                                    <Text text="${= ${exec>/current_estimated_cost} ? ${exec>/current_estimated_cost}.toLocaleString() : '—' } Actual" class="bold" />
                                    <ObjectStatus text="{= ${exec>/deviation/cost_variance} > 0 ? '+$' + ${exec>/deviation/cost_variance}.toLocaleString() : 'Nominal' }" state="{= ${exec>/deviation/cost_variance} > 0 ? 'Warning' : 'Success' }" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- LOGS AND AUDIT TRAIL -->
                    <VBox class="quadsPlanGrid" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
                        
                        <VBox class="sapContentCard" style="height: 100%;">
                            <Title text="Telemetry Event Timeline" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                            <List items="{exec>/tracking_events}" noDataText="No telemetry pings recorded yet." class="sapUiSmallMarginTop">
                                <CustomListItem>
                                    <HBox alignItems="FlexStart" class="sapTimelineItem">
                                        <VBox class="sapUiSmallMarginBegin">
                                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                                <Text text="{exec>status}" class="sapTimelineStatus bold" />
                                                <Text text="{exec>timestamp}" class="textSmall textMuted sapUiSmallMarginBegin" />
                                            </HBox>
                                            <Text text="{exec>description}" class="sapTimelineDesc" />
                                        </VBox>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </VBox>

                        <VBox class="sapContentCard" style="height: 100%;">
                            <Title text="Audit Trail" level="H3" class="sapCardSectionTitle sapUiTinyMarginBottom" />
                            <Table items="{exec>/audit_events}" noDataText="No audit events yet.">
                                <columns>
                                    <Column width="180px"><Text text="Timestamp" class="bold" /></Column>
                                    <Column><Text text="Event" class="bold" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{exec>timestamp}" class="textSmall textMuted" />
                                            <VBox>
                                                <ObjectStatus text="{exec>event}" state="Information" class="bold" />
                                                <Text text="{exec>actor} · {exec>details}" class="textSmall" />
                                            </VBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </VBox>

                    <!-- ═══ BOTTOM ACTIONS ═══ -->
                    <HBox visible="{exec>/is_success}" justifyContent="End" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="View Outcome &#x2192;" type="Emphasized" icon="sap-icon://sys-enter-2" press=".onGoToOutcome" class="sapBtnSuccess" />
                    </HBox>

                    <HBox visible="{exec>/is_failed}" justifyContent="End" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="Return to Recovery Planning" type="Emphasized" icon="sap-icon://journey-change" press=".onReturnToPlanning" class="sapBtnPrimary" />
                    </HBox>

                    <HBox visible="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" justifyContent="SpaceBetween" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="&#x2190; Back to Cases" type="Transparent" press=".onNavBack" class="sapBtnSecondary" />
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
