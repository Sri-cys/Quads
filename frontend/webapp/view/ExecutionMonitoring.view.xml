<mvc:View
    controllerName="com.quads.supplychain.controller.ExecutionMonitoring"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="executionMonitoringPage"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">

        <content>
            <VBox class="sapCorporatePageBody">

                <!-- Consistent Case Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="EXECUTION &amp; MONITORING" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Real-time execution orchestration, carrier tracking, and telemetry monitoring." class="sapCorporatePageSubtitle" />
                    </VBox>
                    <Button
                        text="Refresh Telemetry"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefreshProgress" />
                </HBox>

                <!-- ═══ BANNERS ═══ -->
                <VBox class="sapUiMediumMarginTop">
                    <HBox visible="{exec>/pending_execution}" alignItems="Center" class="quadsExecBanner quadsExecBannerPending sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://decision" class="quadsExecBannerIcon pending" />
                        <VBox>
                            <Text text="AWAITING EXECUTION TRIGGER" class="quadsExecBannerTitle" />
                            <Text text="Checkpoint 2 has been approved. Review the certified recovery plan below and initiate execution." class="quadsExecBannerText" />
                        </VBox>
                    </HBox>
                    
                    <HBox visible="{= !${exec>/pending_execution} &amp;&amp; !${exec>/is_success} &amp;&amp; !${exec>/is_failed} &amp;&amp; !${exec>/action_required} &amp;&amp; ${exec>/monitoring_status} === 'ON_TRACK' }" alignItems="Center" class="quadsExecBanner quadsExecBannerSuccess sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://sys-enter-2" class="quadsExecBannerIcon success" />
                        <VBox>
                            <Text text="RECOVERY EXECUTION IN PROGRESS" class="quadsExecBannerTitle" />
                            <Text text="Plan {exec>/baseline/plan_id} is executing within certified parameters. Telemetry normal." class="quadsExecBannerText" />
                        </VBox>
                    </HBox>
                    
                    <HBox visible="{= !${exec>/pending_execution} &amp;&amp; !${exec>/is_success} &amp;&amp; !${exec>/is_failed} &amp;&amp; !${exec>/action_required} &amp;&amp; ${exec>/monitoring_status} === 'AT_RISK' }" alignItems="Center" class="quadsExecBanner quadsExecBannerWarning sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="quadsExecBannerIcon warning" />
                        <VBox>
                            <Text text="▲ AT RISK — POTENTIAL DEVIATION DETECTED" class="quadsExecBannerTitle" />
                            <Text text="Delivery schedule has slipped. Monitoring buffer coverage to prevent stockout escalation." class="quadsExecBannerText" />
                        </VBox>
                    </HBox>
                    
                    <HBox visible="{= !${exec>/pending_execution} &amp;&amp; ${exec>/action_required} }" alignItems="Center" class="quadsExecBanner quadsExecBannerError sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="quadsExecBannerIcon error" />
                        <VBox>
                            <Text text="⚠ ACTION REQUIRED — CRITICAL OPERATIONAL DEVIATION DETECTED" class="quadsExecBannerTitle" />
                            <Text text="Carrier telemetry indicates delivery schedule or quantity breach exceeding tolerance buffer." class="quadsExecBannerText" />
                        </VBox>
                    </HBox>
                    
                    <HBox visible="{= !${exec>/pending_execution} &amp;&amp; ${exec>/is_success} }" alignItems="Center" class="quadsExecBanner quadsExecBannerSuccess sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://sys-enter-2" class="quadsExecBannerIcon success" />
                        <VBox>
                            <Text text="RECOVERY COMPLETED — CASE RESOLVED" class="quadsExecBannerTitle" />
                            <Text text="All material delivered within tolerance. Case closed and precedent archived." class="quadsExecBannerText" />
                        </VBox>
                    </HBox>

                    <HBox visible="{= !${exec>/pending_execution} &amp;&amp; ${exec>/is_failed} }" alignItems="Center" class="quadsExecBanner quadsExecBannerError sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://alert" class="quadsExecBannerIcon error" />
                        <VBox>
                            <Text text="EXECUTION FAILED — RECOVERY PLANNING REQUIRED" class="quadsExecBannerTitle" />
                            <Text text="{exec>/failure_reason}" class="quadsExecBannerText" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ═══ EXECUTION SUMMARY CARD ═══ -->
                <VBox class="quadsExecCard sapUiSmallMarginBottom">
                    <HBox alignItems="Center" class="quadsExecCardHeader">
                        <Title text="EXECUTION SUMMARY" level="H3" class="quadsExecCardTitle" />
                    </HBox>
                    <layout:Grid defaultSpan="XL4 L4 M4 S6" hSpacing="1" vSpacing="1" class="quadsExecGrid">
                        <VBox>
                            <Text text="PLAN ID" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/plan_id} + ' · ' + ${exec>/approved_plan/version} : ${exec>/baseline/plan_id} + ' · ' + ${exec>/baseline/plan_version} }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="STRATEGY" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/strategy} : ${exec>/baseline/strategy} }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="SOURCE" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/source_name} : ${exec>/baseline/source_name} }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="DESTINATION" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/destination_name} : ${exec>/baseline/target_plant_name} }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="QUANTITY" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/recovered_quantity} + ' units' : ${exec>/baseline/planned_quantity} + ' units' }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="CARRIER" class="quadsExecKpiLabel" />
                            <Text text="{= ${exec>/pending_execution} ? ${exec>/approved_plan/transport_name} : ${exec>/action/carrier_name} }" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="EXPECTED ARRIVAL" class="quadsExecKpiLabel" />
                            <Text text="{path: 'exec>/current_estimated_arrival', formatter: '.formatDateOnly'}" visible="{= !${exec>/pending_execution} }" class="quadsExecKpiValue" />
                            <Text text="{path: 'exec>/approved_plan/expected_delivery_date', formatter: '.formatDateOnly'}" visible="{exec>/pending_execution}" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="ESTIMATED COST" class="quadsExecKpiLabel" />
                            <Text text="{path: 'exec>/current_estimated_cost', formatter: '.formatCurrency'}" visible="{= !${exec>/pending_execution} }" class="quadsExecKpiValue" />
                            <Text text="{path: 'exec>/approved_plan/total_cost', formatter: '.formatCurrency'}" visible="{exec>/pending_execution}" class="quadsExecKpiValue" />
                        </VBox>
                        <VBox>
                            <Text text="CURRENT STATUS" class="quadsExecKpiLabel" />
                            <ObjectStatus text="{= ${exec>/pending_execution} ? 'AWAITING EXECUTION' : ${exec>/execution_status} }" state="{path: 'exec>/execution_status', formatter: '.formatStatusColor'}" class="bold" />
                        </VBox>
                    </layout:Grid>

                    <HBox visible="{exec>/pending_execution}" class="sapDecisionActionsRow sapUiMediumMarginTop" style="border-top: 1px solid #E5E5E5; padding-top: 16px;">
                        <Button text="Back to Recovery Planning" icon="sap-icon://nav-back" type="Transparent" press=".onReturnToPlanning" class="sapUiSmallMarginEnd" />
                        <Button text="Initiate Execution Action" icon="sap-icon://shipping-status" type="Emphasized" press=".onStartExecutionAction" class="sapBtnPrimary" />
                    </HBox>
                </VBox>

                <!-- ═══ EXECUTING PANELS ═══ -->
                <VBox visible="{= !${exec>/pending_execution} }">
                    <!-- RECOVERY EXECUTION PIPELINE CARD -->
                    <VBox class="quadsExecCard sapUiSmallMarginBottom">
                        <HBox alignItems="Center" class="quadsExecCardHeader">
                            <Title text="RECOVERY EXECUTION PIPELINE" level="H3" class="quadsExecCardTitle" />
                        </HBox>
                        
                        <HBox class="quadsExecPipelineRow">
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Plan Confirmed'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Plan Confirmed'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Plan Confirmed'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Plan Confirmed" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Execution Initiated'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Execution Initiated'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Execution Initiated'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Execution Initiated" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Allocated'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Allocated'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Allocated'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Inventory Allocated" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Dispatch Ready'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Dispatch Ready'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Dispatch Ready'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Dispatch Ready" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Picked Up'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Picked Up'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Picked Up'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Picked Up" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'In Transit'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'In Transit'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'In Transit'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="In Transit" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Arrived at Destination'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Arrived at Destination'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Arrived at Destination'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Arrived at Destination" class="quadsExecPipelineLabel" />
                            </VBox>
                            <VBox class="quadsExecPipelineStep">
                                <VBox class="quadsExecPipelineCircle {parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Received'}], formatter: '.formatTrackerStepState'}">
                                    <core:Icon src="{parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Received'}], formatter: '.formatTrackerIconSrc'}" class="quadsExecPipelineIcon {parts: [{path: 'exec>/tracking_events'}, {value: 'Inventory Received'}], formatter: '.formatTrackerStepState'}" />
                                </VBox>
                                <Text text="Inventory Received" class="quadsExecPipelineLabel" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Split Row for Transport and Alerts -->
                    <HBox class="quadsExecSplitRow">
                        <!-- LIVE TRANSPORT STATUS CARD -->
                        <VBox class="quadsExecCard quadsExecSplitCard quadsExecSplitLeft">
                            <HBox alignItems="Center" class="quadsExecCardHeader">
                                <Title text="LIVE TRANSPORT STATUS" level="H3" class="quadsExecCardTitle" />
                            </HBox>
                            
                            <HBox class="quadsExecTransportRow">
                                <Text text="SHIPMENT ID" class="quadsExecTransportLabel" />
                                <Text text="{path: 'exec>/action/tracking_number', formatter: '.formatMissing'}" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="CARRIER" class="quadsExecTransportLabel" />
                                <Text text="{path: 'exec>/action/carrier_name', formatter: '.formatMissing'}" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="VEHICLE ID" class="quadsExecTransportLabel" />
                                <Text text="—" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="CURRENT STATUS" class="quadsExecTransportLabel" />
                                <ObjectStatus text="{path: 'exec>/execution_status', formatter: '.formatStatusText'}" state="{path: 'exec>/execution_status', formatter: '.formatStatusColor'}" class="bold" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="CURRENT LOCATION" class="quadsExecTransportLabel" />
                                <Text text="{path: 'exec>/tracking_events', formatter: '.formatCurrentLocation'}" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="LAST UPDATED" class="quadsExecTransportLabel" />
                                <Text text="{path: 'exec>/last_updated', formatter: '.formatDate'}" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="DISTANCE REMAINING" class="quadsExecTransportLabel" />
                                <Text text="—" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="ETA" class="quadsExecTransportLabel" />
                                <Text text="{path: 'exec>/current_estimated_arrival', formatter: '.formatDateOnly'}" class="quadsExecTransportValue" />
                            </HBox>
                            <HBox class="quadsExecTransportRow">
                                <Text text="DELAY" class="quadsExecTransportLabel" />
                                <ObjectStatus text="{path: 'exec>/deviation/delay_days', formatter: '.formatDelayDaysToMin'}" state="{path: 'exec>/deviation/delay_days', formatter: '.formatDelayState'}" class="bold" />
                            </HBox>

                            <!-- TELEMETRY SIGNAL BLOCK -->
                            <VBox class="sapUiSmallMarginTop">
                                <Text text="TELEMETRY SIGNAL" class="quadsExecKpiLabel" />
                                <Text text="{path: 'exec>/monitoring_status', formatter: '.formatStatusText'}" class="quadsExecKpiValue sapUiTinyMarginBottom" />
                                <Text text="{path: 'exec>/deviation/explanation', formatter: '.formatMissing'}" class="quadsExecBannerText sapUiSmallMarginBottom" />
                            </VBox>
                        </VBox>
                        
                        <!-- ALERTS & EXCEPTIONS CARD -->
                        <VBox class="quadsExecCard quadsExecSplitCard quadsExecSplitRight">
                            <HBox alignItems="Center" class="quadsExecCardHeader">
                                <Title text="ALERTS &amp; EXCEPTIONS" level="H3" class="quadsExecCardTitle" />
                            </HBox>
                            
                            <!-- Empty Alerts View -->
                            <HBox visible="{= !${exec>/action_required} &amp;&amp; !${exec>/is_failed} }" class="quadsExecAlertRow quadsExecAlertSuccess">
                                <core:Icon src="sap-icon://sys-enter-2" class="quadsExecAlertIcon quadsExecAlertSuccessIcon" />
                                <VBox>
                                    <Text text="No active exceptions" class="quadsExecAlertText quadsExecAlertSuccessText" />
                                    <Text text="—" class="quadsExecBannerText sapUiTinyMarginTop" />
                                </VBox>
                            </HBox>

                            <!-- Active Alerts View -->
                            <HBox visible="{exec>/action_required}" class="quadsExecAlertRow">
                                <core:Icon src="sap-icon://error" class="quadsExecAlertIcon" />
                                <VBox>
                                    <Text text="OPERATIONAL INTERVENTION REQUIRED" class="quadsExecAlertText" />
                                    <Text text="{exec>/customer_impact}" class="quadsExecBannerText sapUiTinyMarginTop" />
                                    
                                    <HBox justifyContent="Start" class="sapUiSmallMarginTop">
                                        <Button text="Take Action (Acknowledge Alert)" type="Transparent" press=".onTakeActionAlert" class="sapUiSmallMarginEnd" />
                                        <Button text="Replan Recovery Plan" type="Emphasized" press=".onReplanRecovery" class="sapBtnPrimary" />
                                    </HBox>
                                </VBox>
                            </HBox>

                            <HBox visible="{exec>/is_failed}" class="quadsExecAlertRow">
                                <core:Icon src="sap-icon://error" class="quadsExecAlertIcon" />
                                <VBox>
                                    <Text text="EXECUTION FAILED" class="quadsExecAlertText" />
                                    <Text text="{exec>/failure_reason}" class="quadsExecBannerText sapUiTinyMarginTop" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ═══ RECOVERY OUTCOME ASSESSMENT CARD ═══ -->
                    <!-- Visible during active execution (on-track or at-risk, not yet resolved/failed) -->
                    <VBox visible="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" class="quadsExecCard quadsExecOutcomeCard sapUiMediumMarginTop">
                        <HBox alignItems="Center" class="quadsExecCardHeader">
                            <core:Icon src="sap-icon://complete" class="quadsExecOutcomeIcon sapUiTinyMarginEnd" />
                            <Title text="RECOVERY OUTCOME ASSESSMENT" level="H3" class="quadsExecCardTitle" />
                        </HBox>
                        <Text text="Has the recovery been successfully completed? Confirm outcome below to proceed to archival or restart the planning cycle." class="quadsExecBannerText sapUiSmallMarginBottom" />
                        <HBox justifyContent="Start" class="sapUiSmallMarginTop">
                            <Button
                                id="btnRecoveryCompleted"
                                text="✓  Recovery Completed — Proceed to Outcome"
                                type="Accept"
                                icon="sap-icon://sys-enter-2"
                                press=".onRecoveryCompleted"
                                class="sapUiSmallMarginEnd quadsExecOutcomeBtnSuccess" />
                            <Button
                                id="btnRecoveryNotCompleted"
                                text="✗  Not Completed — Restart Planning Cycle"
                                type="Reject"
                                icon="sap-icon://journey-change"
                                press=".onRecoveryNotCompleted"
                                class="quadsExecOutcomeBtnRestart" />
                        </HBox>
                    </VBox>

                    <!-- Footer Section -->
                    <HBox alignItems="Center" justifyContent="Center" class="quadsExecFooter sapUiLargeMarginTop">
                        <core:Icon src="sap-icon://sys-monitor" class="sapUiTinyMarginEnd" />
                        <Text text="Carrier connections securely monitored via API Gateway" />
                    </HBox>

                    <!-- Bottom Actions -->
                    <HBox visible="{exec>/is_success}" justifyContent="End" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="{= ${app>/completedStage} >= 7 ? 'GO TO OUTCOME &#x2192;' : 'PROCEED TO OUTCOME &#x2192;' }" type="Emphasized" icon="sap-icon://sys-enter-2" press=".onGoToOutcome" class="sapBtnSuccess" />
                    </HBox>
                    <HBox visible="{exec>/is_failed}" justifyContent="End" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="Return to Recovery Planning" type="Emphasized" icon="sap-icon://journey-change" press=".onReturnToPlanning" class="sapBtnPrimary" />
                    </HBox>
                    <HBox visible="{= !${exec>/is_success} &amp;&amp; !${exec>/is_failed} }" justifyContent="SpaceBetween" class="sapUiLargeMarginTop" style="border-top: 1px solid #D9E2EC; padding-top: 24px;">
                        <Button text="&#x2190; Back to Cases" type="Transparent" press=".onNavBack" class="sapBtnSecondary" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
