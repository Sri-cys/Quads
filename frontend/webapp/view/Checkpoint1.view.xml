<mvc:View
    controllerName="com.quads.supplychain.controller.Checkpoint1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    <Page
        id="checkpoint1Page"
        showHeader="false"
        enableScrolling="true"
        class="sapCorporatePage">
        <content>
            <VBox class="sapCorporatePageBody">

                <!-- 8-Stage Non-Navigational Workflow Header -->
                <core:Fragment fragmentName="com.quads.supplychain.view.CaseWorkflowHeader" type="XML" />

                <!-- Page Header: Title + Subtitle + Back Link -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapPageHeaderRow">
                    <VBox>
                        <Title text="CHECKPOINT 1 — RECOVERY PRIORITY" level="H1" class="sapCorporatePageTitle" />
                        <Text text="Select the primary business recovery objective that will govern automated constraints and mitigation planning." class="sapCorporatePageSubtitle" />
                    </VBox>
                    <Link
                        text="&#x2190; Back to Impact Analysis"
                        press=".onBackToImpact"
                        class="sapBackLink" />
                </HBox>

                <!-- 1. Compact Case Summary Bar (Horizontal Context) -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapCompactContextBar">
                    <HBox alignItems="Center" wrap="Wrap" class="sapCompactContextList">
                        <VBox class="sapContextChip">
                            <Text text="CASE" class="sapContextChipLabel" />
                            <Text text="{cp>/case_id}" class="sapContextChipVal" />
                        </VBox>
                        <VBox class="sapContextChip">
                            <Text text="DAYS OF COVER" class="sapContextChipLabel" />
                            <Text text="{cp>/impact/days_of_cover_display}" class="sapContextChipVal textCritical" />
                        </VBox>
                        <VBox class="sapContextChip">
                            <Text text="STOCKOUT RISK" class="sapContextChipLabel" />
                            <Text text="{cp>/impact/stockout_date_display}" class="sapContextChipVal" />
                        </VBox>
                        <VBox class="sapContextChip">
                            <Text text="SUPPLY GAP" class="sapContextChipLabel" />
                            <Text text="{cp>/impact/supply_gap_display}" class="sapContextChipVal textWarning" />
                        </VBox>
                        <VBox class="sapContextChip">
                            <Text text="SEVERITY" class="sapContextChipLabel" />
                            <Text text="{cp>/severity}" class="sapContextChipVal textCritical" />
                        </VBox>
                    </HBox>
                    <ObjectStatus
                        text="{= ${cp>/prioritySaved} ? 'Priority Saved' : 'Priority Pending' }"
                        state="{= ${cp>/prioritySaved} ? 'Success' : 'Warning' }"
                        class="bold" />
                </HBox>

                <!-- 2. Recovery Priority Selection Card -->
                <VBox class="sapDecisionCard sapUiSmallMarginTop">
                    <VBox class="sapDecisionHeader">
                        <Title text="Select Recovery Objective" level="H2" class="sapSectionTitle" />
                        <Text text="Choose which objective the engine must optimize when validating constraints and generating candidate recovery plans." class="sapSectionSub" />
                    </VBox>

                    <!-- 6 Interactive Selectable Objective Cards (3x2 grid) -->
                    <layout:Grid
                        defaultSpan="XL4 L4 M6 S12"
                        hSpacing="1"
                        vSpacing="1"
                        class="sapDecisionGrid">

                        <!-- Card 1: TIME -->
                        <VBox
                            id="cardTime"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://fob-watch" class="sapChoiceIcon" />
                                    <Text text="TIME" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'TIME' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Fastest Recovery" class="sapChoiceSubtitle" />
                            <Text text="Expedite shipment via premium air freight or alternative carrier. Prioritizes shortest lead time to prevent assembly stoppage." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'TIME' ? 'Selected &#x2713;' : 'Select TIME' }"
                                    type="{= ${cp>/selectedPriority} === 'TIME' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectTime"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>

                        <!-- Card 2: COST -->
                        <VBox
                            id="cardCost"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://money-bills" class="sapChoiceIcon" />
                                    <Text text="COST" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'COST' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Lowest Recovery Cost" class="sapChoiceSubtitle" />
                            <Text text="Standard freight routing and volume allocation. Avoids premium expediting surcharges and minimizes budget impact." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'COST' ? 'Selected &#x2713;' : 'Select COST' }"
                                    type="{= ${cp>/selectedPriority} === 'COST' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectCost"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>

                        <!-- Card 3: STOCK -->
                        <VBox
                            id="cardStock"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://product" class="sapChoiceIcon" />
                                    <Text text="STOCK" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'STOCK' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Protect Inventory &amp; Safety Stock" class="sapChoiceSubtitle" />
                            <Text text="Maximize buffer replenishment and prioritize volume fulfillment to safeguard assembly line and warehouse stock floors." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'STOCK' ? 'Selected &#x2713;' : 'Select STOCK' }"
                                    type="{= ${cp>/selectedPriority} === 'STOCK' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectStock"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>

                        <!-- Card 4: RISK -->
                        <VBox
                            id="cardRisk"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://shield" class="sapChoiceIcon" />
                                    <Text text="RISK" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'RISK' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Lowest Operational Risk" class="sapChoiceSubtitle" />
                            <Text text="Multi-source allocation with top-tier reliability partners. Maximizes operational stability across downstream supply nodes." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'RISK' ? 'Selected &#x2713;' : 'Select RISK' }"
                                    type="{= ${cp>/selectedPriority} === 'RISK' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectRisk"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>

                        <!-- Card 5: CUSTOMER -->
                        <VBox
                            id="cardCustomer"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://customer" class="sapChoiceIcon" />
                                    <Text text="CUSTOMER" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'CUSTOMER' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Protect Customer Commitments" class="sapChoiceSubtitle" />
                            <Text text="Prioritize critical customer orders, avoiding SLA breach penalties and preserving delivery commitments." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'CUSTOMER' ? 'Selected &#x2713;' : 'Select CUSTOMER' }"
                                    type="{= ${cp>/selectedPriority} === 'CUSTOMER' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectCustomer"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>

                        <!-- Card 6: BALANCED -->
                        <VBox
                            id="cardBalanced"
                            class="sapChoiceCard"
                            busyIndicatorDelay="0">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapChoiceHeaderRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://dimension" class="sapChoiceIcon" />
                                    <Text text="BALANCED" class="sapChoiceTitle" />
                                </HBox>
                                <core:Icon src="sap-icon://accept" visible="{= ${cp>/selectedPriority} === 'BALANCED' }" class="sapChoiceCheckIcon" />
                            </HBox>
                            <Text text="Balanced Recovery" class="sapChoiceSubtitle" />
                            <Text text="Multi-criteria optimization balancing lead-time recovery, freight expenditure, inventory buffer, and risk profile." class="sapChoiceDesc" />
                            <HBox alignItems="Center" justifyContent="End" class="sapUiTinyMarginTop">
                                <Button
                                    text="{= ${cp>/selectedPriority} === 'BALANCED' ? 'Selected &#x2713;' : 'Select BALANCED' }"
                                    type="{= ${cp>/selectedPriority} === 'BALANCED' ? 'Emphasized' : 'Default' }"
                                    press=".onSelectBalanced"
                                    class="sapUiTinyMarginTop" />
                            </HBox>
                        </VBox>
                    </layout:Grid>

                    <!-- Decision Action Row: Selected Priority + Save / Proceed Buttons -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapDecisionActionsRow sapUiSmallMarginTop">
                        <HBox alignItems="Center">
                            <Text text="Selected Priority:" class="sapUiTinyMarginEnd textMuted bold" />
                            <Text text="{cp>/selectedPriority}" class="sapSelectedPriorityBadge" />
                        </HBox>
                        <HBox alignItems="Center">
                            <Button
                                text="Back to Impact Analysis"
                                type="Transparent"
                                press=".onBackToImpact"
                                class="sapUiSmallMarginEnd" />

                            <!-- 1. Pending: SAVE PRIORITY -->
                            <Button
                                id="btnSavePriority"
                                text="SAVE PRIORITY"
                                icon="sap-icon://save"
                                type="Emphasized"
                                visible="{= !${cp>/prioritySaved} }"
                                press=".onSavePriority"
                                class="sapBtnPrimary sapUiTinyMarginEnd" />

                            <!-- 2. Saved: PROCEED TO CONSTRAINTS -->
                            <Button
                                id="btnProceedConstraints"
                                text="PROCEED TO CONSTRAINTS &#x2192;"
                                icon="sap-icon://navigation-right-arrow"
                                type="Emphasized"
                                visible="{= ${cp>/prioritySaved} === true }"
                                press=".onProceedToConstraints"
                                class="sapBtnPrimary" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Priority Saved Governance Notice -->
                <VBox
                    visible="{= ${cp>/prioritySaved} === true }"
                    class="sapPhase1Banner sapUiSmallMarginTop">
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://sys-enter-2" class="sapBannerIcon success" />
                        <VBox class="sapUiSmallMarginBegin" width="100%">
                            <Title text="Priority Objective Saved: {cp>/selectedPriority}" level="H3" class="sapBannerTitle" />
                            <Text text="Priority selection is persisted in the governance audit trail. Stage 4: Constraints Analysis (Agent 2) is now unlocked." class="sapBannerText" />
                            <HBox class="sapUiSmallMarginTop" justifyContent="End">
                                <Button
                                    text="PROCEED TO CONSTRAINTS &#x2192;"
                                    icon="sap-icon://navigation-right-arrow"
                                    type="Emphasized"
                                    press=".onProceedToConstraints" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
