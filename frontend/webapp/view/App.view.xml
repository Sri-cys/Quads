<mvc:View
    controllerName="com.quads.supplychain.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">
    <VBox fitContainer="true" class="sapCorporateAppWrapper">

        <!-- Unified Single-Line Permanent Main Navbar -->
        <HBox id="unifiedNavHeader" alignItems="Center" class="sapUnifiedNavHeader">

            <!-- 1. Brand Section: [ SAP | Quads | Supply Chain Control Tower ] -->
            <HBox alignItems="Center" class="sapBrandGroup" press=".onTopNavDashboard">
                <Image src="img/sap-logo.svg" height="22px" class="sapLogoHeaderImg" tooltip="SAP" />
                <Text text="Quads" class="sapBrandQuadsText" />
                <Text text="|" class="sapBrandSeparator" />
                <Text text="Supply Chain Control Tower" class="sapBrandControlTowerText" />
            </HBox>

            <!-- Vertical Separator -->
            <VBox class="sapHeaderDivider" />

            <!-- 2. Primary Permanent Navigation: Exactly 6 Product Sections -->
            <HBox alignItems="Center" class="sapUnifiedNavList">
                <Button id="topNavDashboard"
                    text="Dashboard"
                    type="Transparent"
                    press=".onTopNavDashboard"
                    class="sapUnifiedNavItem" />
                <Button id="topNavCases"
                    text="Cases"
                    type="Transparent"
                    press=".onTopNavCases"
                    class="sapUnifiedNavItem" />
                <Button id="topNavImpactAnalysis"
                    text="Impact Analysis"
                    type="Transparent"
                    press=".onTopNavImpactAnalysis"
                    class="sapUnifiedNavItem" />
                <Button id="topNavRecovery"
                    text="Recovery Planning"
                    type="Transparent"
                    press=".onTopNavRecovery"
                    class="sapUnifiedNavItem" />
                <Button id="topNavExecution"
                    text="Execution &amp; Monitoring"
                    type="Transparent"
                    press=".onTopNavExecution"
                    class="sapUnifiedNavItem" />
                <Button id="topNavOutcome"
                    text="Outcome"
                    type="Transparent"
                    press=".onTopNavOutcome"
                    class="sapUnifiedNavItem" />
            </HBox>

            <!-- 3. Utilities: [ Search ] [ Notifications ] [ Help ] [ Settings ] [ Profile ] -->
            <HBox alignItems="Center" class="sapTopUtilities">
                <Button icon="sap-icon://search"          type="Transparent" tooltip="Search Cases" press=".onSearchPress"       class="sapHeaderUtilityBtn" />
                <Button icon="sap-icon://bell"            type="Transparent" tooltip="Alerts"       press=".onNotificationPress" class="sapHeaderUtilityBtn" />
                <Button icon="sap-icon://sys-help"        type="Transparent" tooltip="Help"         press=".onHelpPress"         class="sapHeaderUtilityBtn" />
                <Button icon="sap-icon://action-settings" type="Transparent" tooltip="Settings"     press=".onSettingsPress"     class="sapHeaderUtilityBtn" />
                <HBox alignItems="Center" class="sapUserAvatarGroup">
                    <Avatar initials="SC" displaySize="XS" class="sapHeaderUserAvatar" press=".onUserPress" tooltip="Operator Profile" />
                </HBox>
            </HBox>
        </HBox>

        <!-- Main Content Canvas -->
        <NavContainer id="pageContainer" class="sapCorporateNavContainer">
            <layoutData>
                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="auto" />
            </layoutData>
        </NavContainer>
    </VBox>
</mvc:View>
